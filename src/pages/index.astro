---
import { Image } from "astro:assets";
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import portraitImage from "../assets/Jonathan_Acevedo.webp";
import profileData from "../data/profile.json";
import "../styles/global.css";

const profileCvPath = typeof profileData.cvPath === "string" ? profileData.cvPath.trim() : "";
const cvFileExists = profileCvPath
  ? /^(?:[a-z][a-z\d+\-.]*:|#)/i.test(profileCvPath) ||
    existsSync(resolve(process.cwd(), "public", profileCvPath.replace(/^\//, "")))
  : false;
const baseUrl = import.meta.env.BASE_URL || "/";
const withBase = (path) => `${baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`}${path.replace(/^\//, "")}`;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portafolio Jonathan Acevedo</title>
    <meta
      name="description"
      content="Portafolio personal para presentar proyectos, proceso y formas de contacto."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Manrope:wght@400;500;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Manrope:wght@400;500;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <script is:inline>
      (() => {
        if ("scrollRestoration" in window.history) {
          window.history.scrollRestoration = "manual";
        }

        const isMobileInitialLoad = window.matchMedia("(max-width: 767px)").matches;

        if (isMobileInitialLoad && window.location.hash) {
          window.history.replaceState(null, "", `${window.location.pathname}${window.location.search}`);
        }

        const shouldResetToHome = isMobileInitialLoad || !window.location.hash;
        const resetToHome = () => {
          if (!shouldResetToHome) {
            return;
          }

          window.scrollTo({ top: 0, left: 0, behavior: "auto" });
        };

        resetToHome();

        window.addEventListener(
          "pageshow",
          () => {
            window.requestAnimationFrame(() => {
              resetToHome();
            });
          },
          { once: true },
        );

        window.addEventListener(
          "load",
          () => {
            window.requestAnimationFrame(() => {
              resetToHome();
              window.setTimeout(resetToHome, 120);
              window.setTimeout(resetToHome, 360);
            });
          },
          { once: true },
        );

        const storedTheme = window.localStorage.getItem("portfolio-theme");
        const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = storedTheme || (systemPrefersDark ? "dark" : "light");

        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.classList.toggle("light", theme === "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body
    class="bg-background font-body text-on-surface selection:bg-secondary/30"
    data-base-url={baseUrl}
    data-cv-available={cvFileExists ? "true" : "false"}
  >
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="orb orb-primary"></div>
      <div class="orb orb-secondary"></div>
      <div class="grid-overlay"></div>
    </div>

    <header class="fixed inset-x-0 top-0 z-50 px-3 pt-3 lg:px-4">
      <nav class="site-shell site-shell--nav mx-auto flex max-w-7xl items-center justify-between rounded-[1.7rem] border border-outline-variant/15 bg-background/72 px-6 py-3 shadow-[0_18px_54px_rgba(0,0,0,0.24)] backdrop-blur-xl lg:px-8">
        <a href="#home" class="font-headline text-base font-black tracking-tight text-on-surface sm:text-xl" id="brand-text">
          TU NOMBRE
        </a>

        <div class="hidden items-center gap-3 lg:flex xl:gap-6">
          <a class="nav-link" href="#home" data-i18n="nav.home">Inicio</a>
          <a class="nav-link" href="#about" data-i18n="nav.about">Sobre mí</a>
          <a class="nav-link" href="#development" data-i18n="nav.development">En desarrollo</a>
          <a class="nav-link" href="#projects" data-i18n="nav.projects">Proyectos</a>
          <a class="nav-link" href="#certificates" data-i18n="nav.certificates">Certificados</a>
          <a class="nav-link" href="#insights" data-i18n="nav.insights">Blog</a>
          <a class="nav-link" href="#interests" data-i18n="nav.interests">Intereses</a>
          <a class="nav-link" href="#contact" data-i18n="nav.contact">Contacto</a>
        </div>

        <div class="flex items-center gap-3">
          <button
            type="button"
            id="language-toggle"
            class="lang-toggle border border-outline-variant/20 bg-surface-container-highest/50"
            aria-label="Switch to English"
            title="Switch to English"
          >
            <svg class="lang-flag" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="10" fill="#FCD116" />
              <path d="M2 12a10 10 0 0 0 20 0Z" fill="#003893" />
              <path d="M3.34 16.99a10 10 0 0 0 17.32 0Z" fill="#CE1126" />
            </svg>
          </button>

          <button
            type="button"
            id="theme-toggle"
            class="theme-toggle border border-outline-variant/20 bg-surface-container-highest/50 text-on-surface transition hover:border-secondary hover:text-secondary"
            aria-label="Cambiar a modo claro"
            title="Cambiar a modo claro"
          >
            <span class="theme-toggle-icon" id="theme-toggle-icon" aria-hidden="true">
              <svg class="icon-symbol theme-toggle-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2.2"></path>
                <path d="M12 19.8V22"></path>
                <path d="m4.93 4.93 1.56 1.56"></path>
                <path d="m17.51 17.51 1.56 1.56"></path>
                <path d="M2 12h2.2"></path>
                <path d="M19.8 12H22"></path>
                <path d="m4.93 19.07 1.56-1.56"></path>
                <path d="m17.51 6.49 1.56-1.56"></path>
              </svg>
            </span>
          </button>

          <button
            type="button"
            id="menu-toggle"
            class="inline-flex items-center justify-center rounded-full border border-outline-variant/20 bg-surface-container-highest/50 p-2 text-on-surface transition hover:border-secondary hover:text-secondary lg:hidden"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Abrir menu"
          >
            <svg class="icon-symbol menu-toggle-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 7h16"></path>
              <path d="M4 12h16"></path>
              <path d="M4 17h16"></path>
            </svg>
          </button>
        </div>
      </nav>

      <div id="mobile-menu" class="mobile-menu lg:hidden">
        <div class="mobile-menu-panel mx-3 mt-3 rounded-[1.5rem] border border-outline-variant/20 p-5 shadow-[0_20px_70px_rgba(0,0,0,0.35)]">
          <div class="flex flex-col gap-4">
            <a class="mobile-link" href="#home" data-i18n="nav.home">Inicio</a>
            <a class="mobile-link" href="#about" data-i18n="nav.about">Sobre mí</a>
            <a class="mobile-link" href="#development" data-i18n="nav.development">En desarrollo</a>
            <a class="mobile-link" href="#projects" data-i18n="nav.projects">Proyectos</a>
            <a class="mobile-link" href="#certificates" data-i18n="nav.certificates">Certificados</a>
            <a class="mobile-link" href="#insights" data-i18n="nav.insights">Blog</a>
            <a class="mobile-link" href="#interests" data-i18n="nav.interests">Intereses</a>
            <a class="mobile-link" href="#contact" data-i18n="nav.contact">Contacto</a>
          </div>
        </div>
      </div>
    </header>

    <main class="pt-[5.75rem] sm:pt-[6rem]">
      <section id="home" class="relative overflow-hidden px-6 pb-16 pt-2 lg:px-8 lg:pt-3">
        <div id="hero-mascot-field" class="hero-mascot-field" aria-hidden="true">
          <div
            class="hero-mascot hero-mascot--kira"
            data-hero-mascot
            data-idle-src={withBase("/pets/vscode-pets/dog/brown_idle_8fps.gif")}
            data-walk-src={withBase("/pets/vscode-pets/dog/brown_walk_8fps.gif")}
            data-title-src={withBase("/pets/vscode-pets/dog/brown_swipe_8fps.gif")}
            data-card-src={withBase("/pets/vscode-pets/dog/brown_walk_8fps.gif")}
            data-pet-name="Kira"
          >
            <div class="hero-mascot-core">
              <span class="hero-mascot-halo"></span>
              <span class="hero-mascot-name">Kira</span>
              <img
                class="hero-mascot-sprite"
                src={withBase("/pets/vscode-pets/dog/brown_walk_8fps.gif")}
                alt=""
                draggable="false"
              />
            </div>
          </div>

          <div
            class="hero-mascot hero-mascot--paco"
            data-hero-mascot
            data-idle-src={withBase("/pets/vscode-pets/dog/black_idle_8fps.gif")}
            data-walk-src={withBase("/pets/vscode-pets/dog/black_walk_8fps.gif")}
            data-title-src={withBase("/pets/vscode-pets/dog/black_walk_8fps.gif")}
            data-card-src={withBase("/pets/vscode-pets/dog/black_swipe_8fps.gif")}
            data-pet-name="Paco"
          >
            <div class="hero-mascot-core">
              <span class="hero-mascot-halo"></span>
              <span class="hero-mascot-card-bubble"></span>
              <span class="hero-mascot-name">Paco</span>
              <img
                class="hero-mascot-sprite"
                src={withBase("/pets/vscode-pets/dog/black_walk_8fps.gif")}
                alt=""
                draggable="false"
              />
            </div>
          </div>
        </div>

        <div class="site-shell site-shell--main hero-shell mx-auto grid max-w-7xl items-start gap-5 sm:gap-6 lg:grid-cols-12 lg:items-center lg:gap-8">
          <div class="contents lg:relative lg:z-10 lg:block lg:col-span-7">
            <h1
              id="hero-title"
              class="hero-title-animated hero-display order-1 max-w-4xl text-[2rem] font-bold leading-[1.02] tracking-tight text-on-surface sm:text-5xl sm:leading-[1.04] lg:text-6xl"
            >
              <span class="hero-word" style="--word-index: 0">Hola,</span>
              <span class="hero-word" style="--word-index: 1">soy</span>
              <span class="hero-word text-primary" style="--word-index: 2">Jonathan,</span>
              <br />
              <span class="hero-word" style="--word-index: 3">ingeniero</span>
              <span class="hero-word" style="--word-index: 4">de</span>
              <span class="hero-word" style="--word-index: 5">sistemas.</span>
            </h1>

            <div class="order-3 mt-1 lg:mt-0">
              <p
                id="hero-description"
                class="hero-description-copy hero-copy max-w-2xl text-base leading-7 text-on-surface-variant sm:text-lg lg:mt-5"
              >
                Me considero una persona curiosa, apasionada por los retos y por encontrar soluciones innovadoras. Disfruto relacionarme con las personas, enfrentar nuevos desafios y trabajar en equipo para crecer, aportar y generar un impacto positivo.
              </p>

              <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:flex lg:flex-wrap">
                <button
                  type="button"
                  class="inline-flex w-full items-center justify-center rounded-2xl bg-primary px-6 py-3.5 font-headline text-sm font-bold tracking-tight text-on-primary shadow-[0_14px_32px_rgba(177,161,255,0.22)] transition hover:-translate-y-0.5 hover:shadow-[0_16px_40px_rgba(177,161,255,0.34)] sm:w-auto"
                  data-scroll-target="#projects"
                  id="hero-primary-button"
                >
                  Ver proyectos
                </button>

                <button
                  type="button"
                  class="inline-flex w-full items-center justify-center rounded-2xl border border-secondary/25 px-6 py-3.5 text-sm font-bold tracking-tight text-secondary transition hover:border-secondary hover:bg-secondary/5 sm:w-auto"
                  data-scroll-target="#contact"
                  id="hero-secondary-button"
                >
                  Hablemos
                </button>
              </div>

              <div class="mt-5">
                <a
                  id="hero-email"
                  class="inline-flex items-center gap-2 text-sm font-semibold tracking-tight text-on-surface-variant transition hover:text-secondary"
                  href="mailto:jonalopezacevedo@gmail.com"
                >
                  <svg class="icon-symbol text-base" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                    <path d="m4 7 8 6 8-6"></path>
                  </svg>
                  <span>jonalopezacevedo@gmail.com</span>
                </a>
              </div>

              <div id="hero-link-grid" class="mt-5 grid grid-cols-2 gap-3 lg:flex lg:flex-wrap"></div>
            </div>
          </div>

          <div class="relative order-2 w-full lg:order-none lg:col-span-5">
            <div class="visual-panel visual-portrait hero-portrait-shell mx-auto min-h-[320px] max-w-[30rem] rounded-[1.8rem] sm:min-h-[420px] lg:min-h-[480px] lg:max-w-none">
              <Image
                src={portraitImage}
                alt="Foto de Jonathan Acevedo"
                class="hero-photo"
                widths={[480, 640, 768, 960, 1280, 1600]}
                sizes="(max-width: 639px) calc(100vw - 4rem), (max-width: 1023px) calc(50vw - 4rem), (max-width: 1535px) 38rem, 44rem"
                quality={72}
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />

              <div class="absolute bottom-3 left-3 right-3 z-10 flex justify-center sm:inset-x-4 sm:bottom-4 lg:inset-x-5 lg:bottom-5">
                <div class="glass-panel hero-focus-card mx-auto w-[20rem] max-w-full rounded-[1.05rem] px-3.5 py-1.5 text-center sm:w-[22rem] sm:rounded-[1.2rem] sm:px-4 sm:py-2.5 lg:w-[28.5rem] lg:max-w-[28.5rem] lg:px-4.5 lg:py-2.5 xl:w-[30rem] xl:max-w-[30rem]">
                  <p class="text-[0.58rem] font-black uppercase tracking-[0.16em] text-primary sm:text-[0.64rem] sm:tracking-[0.18em]" data-i18n="hero.focusLabel">
                    Enfoque
                  </p>
                  <h2
                    id="hero-focus"
                    class="mx-auto mt-1 max-w-[17.5rem] font-headline text-[0.82rem] font-bold leading-[1.16] text-on-surface sm:mt-1.5 sm:max-w-[19rem] sm:text-[0.94rem] sm:leading-[1.18] lg:mt-1.5 lg:max-w-[23.75rem] lg:text-[1.12rem] lg:leading-[1.12] xl:max-w-[25rem] xl:text-[1.2rem]"
                  >
                    Interfaces memorables con estrategia, sistema y detalle.
                  </h2>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="about" class="px-6 pt-24 pb-14 lg:px-8 lg:pt-24 lg:pb-16">
        <div class="site-shell site-shell--main mx-auto max-w-7xl" data-section-anchor>
          <div class="mb-9 flex flex-col gap-5 lg:mb-10 lg:max-w-[44rem]">
            <div class="flex flex-col gap-3">
              <h2 class="text-4xl font-bold tracking-tight text-on-surface sm:text-5xl" data-i18n="about.title">
                Sobre mí
              </h2>
              <p class="max-w-2xl text-sm leading-7 text-on-surface-variant sm:text-base" data-i18n="about.subtitle">
                Formación académica y experiencia laboral.
              </p>
            </div>
          </div>

          <div id="about-profile-grid" class="grid gap-4 lg:grid-cols-2 lg:gap-5"></div>
        </div>
      </section>

      <section id="development" class="border-y border-outline-variant/10 bg-surface-container-low/35 px-6 py-16 lg:px-8 lg:py-20">
        <div class="site-shell site-shell--main mx-auto max-w-7xl" data-section-anchor>
          <div class="mb-9 flex flex-col gap-5 lg:mb-10 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
            <div class="flex flex-1 flex-col gap-3">
              <h2 class="text-4xl font-bold tracking-tight text-on-surface sm:text-5xl" data-i18n="development.title">
                En desarrollo
              </h2>
              <p class="max-w-none text-sm leading-7 text-on-surface-variant sm:text-base" data-i18n="development.subtitle">
                Proyectos y certificados en los que estoy trabajando antes de publicarlos como terminados.
              </p>
            </div>

            <div id="development-filters" class="flex flex-wrap gap-3">
              <button type="button" class="filter-chip" data-development-filter="all">Todos</button>
              <button type="button" class="filter-chip" data-development-filter="project">Proyectos</button>
              <button type="button" class="filter-chip" data-development-filter="certificate">Certificados</button>
            </div>
          </div>

          <div class="development-scroll-frame">
            <div id="development-grid" class="development-grid"></div>
          </div>
        </div>
      </section>

      <section id="projects" class="px-6 pt-10 pb-16 lg:px-8 lg:pt-12 lg:pb-20">
        <div class="site-shell site-shell--main mx-auto max-w-7xl" data-section-anchor>
          <div class="mb-9 flex flex-col gap-5 lg:mb-10 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
            <div>
              <h2 class="text-3xl font-bold tracking-tight text-on-surface sm:text-4xl lg:text-[2.7rem]" data-i18n="projects.title">
                Proyectos destacados
              </h2>
            </div>

            <div id="project-filters" class="project-filter-bar flex flex-wrap gap-3">
              <button type="button" class="filter-chip" data-filter="all">Todos</button>
            </div>
          </div>

          <div id="projects-grid" class="projects-scroll-row custom-scrollbar"></div>
        </div>
      </section>

      <section id="certificates" class="border-y border-outline-variant/10 bg-surface-container-low/35 px-6 py-16 lg:px-8 lg:py-20">
        <div class="site-shell site-shell--main mx-auto max-w-7xl" data-section-anchor>
          <div class="mb-9 flex flex-col gap-5 lg:mb-10 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
            <div class="flex flex-1 flex-col gap-3">
              <h2 class="text-4xl font-bold tracking-tight text-on-surface sm:text-5xl" data-i18n="certificates.title">
                Certificados
              </h2>
            </div>

            <div class="certificate-privacy-badge">
              <span class="certificate-privacy-badge-icon" aria-hidden="true">
                <svg class="icon-symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3 5 6v5c0 5 3.5 8.5 7 10 3.5-1.5 7-5 7-10V6l-7-3Z"></path>
                  <path d="m9.5 12 1.8 1.8 3.7-4"></path>
                </svg>
              </span>
              <span data-i18n="certificates.privacyBadge">En progreso</span>
            </div>
          </div>

          <div id="certificates-grid" class="certificates-grid custom-scrollbar grid gap-4 sm:grid-cols-2 xl:grid-cols-3"></div>
        </div>
      </section>

      <section id="insights" class="border-y border-outline-variant/10 bg-surface-container-low/40 px-6 py-16 lg:px-8 lg:py-20">
        <div class="site-shell site-shell--main mx-auto max-w-7xl" data-section-anchor>
          <div class="mb-8 flex flex-col gap-5 lg:mb-9 lg:flex-row lg:items-end lg:justify-between">
            <h2 class="text-4xl font-bold tracking-tight text-on-surface sm:text-5xl" data-i18n="insights.title">
              Blog
            </h2>
            <div id="insights-filters" class="flex flex-wrap gap-3">
              <button type="button" class="filter-chip" data-article-filter="all">Todos</button>
            </div>
          </div>

          <div class="split-feature-grid grid gap-5 lg:grid-cols-[minmax(16rem,24rem)_minmax(0,1fr)] lg:items-start lg:gap-6">
            <div id="articles-list" class="articles-scroll-column custom-scrollbar order-2 lg:order-1"></div>
            <article id="article-feature" class="order-1 lg:order-2 lg:sticky lg:top-28 lg:self-start"></article>
          </div>
        </div>
      </section>

      <section id="interests" class="px-6 py-16 lg:px-8 lg:py-20">
        <div class="site-shell site-shell--main mx-auto max-w-7xl" data-section-anchor>
          <div class="mb-8 flex flex-col gap-5 lg:mb-9 lg:flex-row lg:items-end lg:justify-between">
            <div class="flex flex-1 flex-col gap-3">
              <h2 class="text-4xl font-bold tracking-tight text-on-surface sm:text-5xl" data-i18n="interests.title">
                Intereses
              </h2>
              <p class="max-w-none text-sm leading-7 text-on-surface-variant sm:text-base" data-i18n="interests.subtitle">
                Gustos personales, referencias e ideas que alimentan mi forma de crear.
              </p>
            </div>
            <div id="interests-media-filters" class="flex flex-wrap gap-3">
              <button type="button" class="filter-chip" data-interest-filter="all">Todo</button>
              <button type="button" class="filter-chip" data-interest-filter="movies">Peliculas</button>
              <button type="button" class="filter-chip" data-interest-filter="series">Series</button>
              <button type="button" class="filter-chip" data-interest-filter="anime">Animes</button>
              <button type="button" class="filter-chip" data-interest-filter="books">Libros</button>
              <button type="button" class="filter-chip" data-interest-filter="games">Videojuegos</button>
            </div>
          </div>

          <div class="split-feature-grid grid gap-5 lg:grid-cols-[minmax(16rem,24rem)_minmax(0,1fr)] lg:items-start lg:gap-6">
            <div id="interests-media-list" class="articles-scroll-column custom-scrollbar order-2 lg:order-1"></div>
            <article id="interests-media-feature" class="order-1 lg:order-2 lg:sticky lg:top-28 lg:self-start"></article>
          </div>
        </div>
      </section>

    </main>

    <footer id="contact" class="relative overflow-hidden border-t border-outline-variant/10 bg-background px-6 py-24 lg:px-8">
      <div class="site-shell site-shell--main mx-auto max-w-7xl space-y-8" data-section-anchor>
        <div class="space-y-8">
          <h2 class="text-4xl font-bold tracking-tight text-on-surface sm:text-5xl" data-i18n="contact.title">
            Contáctame
          </h2>

          <div id="contact-grid" class="contact-responsive-grid mx-auto grid max-w-5xl grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-5"></div>
          <div class="site-shell site-shell--compact mx-auto mt-12 max-w-4xl" id="footer-legal-line">
            <p
              class="rounded-[1.45rem] border border-outline-variant/18 bg-surface-container-highest/74 px-5 py-4 text-center text-[0.78rem] font-bold tracking-[0.08em] text-on-surface-variant/90 shadow-[0_18px_40px_rgba(17,5,30,0.16)] sm:px-6 sm:text-sm"
              data-i18n="footer.legalLine"
            >
              © 2026 Jonathan Estiben Acevedo López • Todos los derechos reservados
            </p>
          </div>
        </div>
      </div>
    </footer>

    <div
      id="project-preview-modal"
      class="project-preview-modal"
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-labelledby="project-preview-modal-title"
    >
      <div class="project-preview-backdrop" data-project-modal-close></div>
      <div class="project-preview-shell">
        <div class="project-preview-window">
          <div class="project-preview-window-top">
            <div>
              <p class="project-preview-window-label">Demo interactiva</p>
              <h2 id="project-preview-modal-title" class="project-preview-window-title">Docqee</h2>
            </div>

            <div class="project-preview-window-actions">
              <a
                id="project-preview-open-site"
                href="https://docqee.vercel.app/"
                target="_blank"
                rel="noopener noreferrer"
                class="project-preview-open-link"
              >
                Ir al sitio
              </a>
              <button
                type="button"
                id="project-preview-close"
                class="project-preview-close"
                aria-label="Cerrar vista interactiva"
                data-project-modal-close
              >
                Cerrar
              </button>
            </div>
          </div>

          <div class="project-preview-browser">
            <iframe
              id="project-preview-iframe"
              src="about:blank"
              title="Vista interactiva del proyecto"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              sandbox="allow-forms allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts"
              allow="fullscreen"
              class="project-preview-browser-frame"
            ></iframe>
          </div>
        </div>
      </div>
    </div>

    <script>
      import "../scripts/portfolio.js";
