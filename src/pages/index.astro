---
import { Image } from "astro:assets";
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import portraitImage from "../assets/Jonathan_Acevedo.webp";
import portfolioScript from "../scripts/portfolio.js?url";
import "../styles/global.css";

const cvFileExists = existsSync(resolve(process.cwd(), "public", "CV_Ejemplo.pdf"));
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portafolio Jonathan Acevedo</title>
    <meta
      name="description"
      content="Portafolio personal para presentar proyectos, proceso y formas de contacto."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        if ("scrollRestoration" in window.history) {
          window.history.scrollRestoration = "manual";
        }

        window.addEventListener(
          "pageshow",
          () => {
            window.requestAnimationFrame(() => {
              window.scrollTo({ top: 0, left: 0, behavior: "auto" });
            });
          },
          { once: true },
        );

        const storedTheme = window.localStorage.getItem("portfolio-theme");
        const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = storedTheme || (systemPrefersDark ? "dark" : "light");

        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.classList.toggle("light", theme === "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-background font-body text-on-surface selection:bg-secondary/30" data-cv-available={cvFileExists ? "true" : "false"}>
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="orb orb-primary"></div>
      <div class="orb orb-secondary"></div>
      <div class="grid-overlay"></div>
    </div>

    <header class="sticky top-0 z-50 px-3 pt-3 lg:px-4">
      <nav class="mx-auto flex max-w-7xl items-center justify-between rounded-[1.7rem] border border-outline-variant/15 bg-background/72 px-6 py-3 shadow-[0_18px_54px_rgba(0,0,0,0.24)] backdrop-blur-xl lg:px-8">
        <a href="#home" class="font-headline text-base font-black tracking-tight text-on-surface sm:text-xl" id="brand-text">
          TU NOMBRE
        </a>

        <div class="hidden items-center gap-8 md:flex">
          <a class="nav-link" href="#home" data-i18n="nav.home">Inicio</a>
          <a class="nav-link" href="#projects" data-i18n="nav.projects">Proyectos</a>
          <a class="nav-link" href="#insights" data-i18n="nav.insights">Blog</a>
          <a class="nav-link" href="#about" data-i18n="nav.about">Sobre mi</a>
          <a class="nav-link" href="#contact" data-i18n="nav.contact">Contacto</a>
        </div>

        <div class="flex items-center gap-3">
          <button
            type="button"
            id="language-toggle"
            class="lang-toggle border border-outline-variant/20 bg-surface-container-highest/50"
            aria-label="Switch to English"
            title="Switch to English"
          >
            <svg class="lang-flag" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="10" fill="#FCD116" />
              <path d="M2 12a10 10 0 0 0 20 0Z" fill="#003893" />
              <path d="M3.34 16.99a10 10 0 0 0 17.32 0Z" fill="#CE1126" />
            </svg>
          </button>

          <button
            type="button"
            id="theme-toggle"
            class="theme-toggle border border-outline-variant/20 bg-surface-container-highest/50 text-on-surface transition hover:border-secondary hover:text-secondary"
            aria-label="Cambiar a modo claro"
            title="Cambiar a modo claro"
          >
            <span class="material-symbols-outlined theme-toggle-icon" id="theme-toggle-icon">light_mode</span>
          </button>

          <button
            type="button"
            id="menu-toggle"
            class="inline-flex items-center justify-center rounded-full border border-outline-variant/20 bg-surface-container-highest/50 p-2 text-on-surface transition hover:border-secondary hover:text-secondary md:hidden"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Abrir menu"
          >
            <span class="material-symbols-outlined">menu</span>
          </button>
        </div>
      </nav>

      <div id="mobile-menu" class="mobile-menu md:hidden">
        <div class="mobile-menu-panel mx-3 mt-3 rounded-[1.5rem] border border-outline-variant/20 p-5 shadow-[0_20px_70px_rgba(0,0,0,0.35)]">
          <div class="flex flex-col gap-4">
            <a class="mobile-link" href="#home" data-i18n="nav.home">Inicio</a>
            <a class="mobile-link" href="#projects" data-i18n="nav.projects">Proyectos</a>
            <a class="mobile-link" href="#insights" data-i18n="nav.insights">Blog</a>
            <a class="mobile-link" href="#about" data-i18n="nav.about">Sobre mi</a>
            <a class="mobile-link" href="#contact" data-i18n="nav.contact">Contacto</a>
          </div>
        </div>
      </div>
    </header>

    <main>
      <section id="home" class="relative overflow-hidden px-6 pb-16 pt-2 lg:px-8 lg:pt-3">
        <div class="mx-auto grid max-w-7xl items-start gap-5 sm:gap-6 lg:grid-cols-12 lg:items-center lg:gap-8">
          <div class="contents lg:relative lg:z-10 lg:block lg:col-span-7">
            <h1
              id="hero-title"
              class="hero-title-animated order-1 max-w-4xl text-[2rem] font-bold leading-[1.02] tracking-tight text-on-surface sm:text-5xl sm:leading-[1.04] lg:text-6xl"
            >
              <span class="hero-word" style="--word-index: 0">Hola,</span>
              <span class="hero-word" style="--word-index: 1">soy</span>
              <span class="hero-word text-primary" style="--word-index: 2">Jonathan,</span>
              <br />
              <span class="hero-word" style="--word-index: 3">ingeniero</span>
              <span class="hero-word" style="--word-index: 4">de</span>
              <span class="hero-word" style="--word-index: 5">sistemas.</span>
            </h1>

            <div class="order-3 mt-1 lg:mt-0">
              <p
                id="hero-description"
                class="hero-description-copy max-w-2xl text-base leading-7 text-on-surface-variant sm:text-lg lg:mt-5"
              >
                Me considero una persona curiosa, apasionada por los retos y por encontrar soluciones innovadoras. Disfruto relacionarme con las personas, enfrentar nuevos desafios y trabajar en equipo para crecer, aportar y generar un impacto positivo.
              </p>

              <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:flex lg:flex-wrap">
                <button
                  type="button"
                  class="inline-flex w-full items-center justify-center rounded-2xl bg-primary px-6 py-3.5 font-headline text-sm font-bold tracking-tight text-on-primary shadow-[0_14px_32px_rgba(177,161,255,0.22)] transition hover:-translate-y-0.5 hover:shadow-[0_16px_40px_rgba(177,161,255,0.34)] sm:w-auto"
                  data-scroll-target="#projects"
                  id="hero-primary-button"
                >
                  Ver proyectos
                </button>

                <button
                  type="button"
                  class="inline-flex w-full items-center justify-center rounded-2xl border border-secondary/25 px-6 py-3.5 text-sm font-bold tracking-tight text-secondary transition hover:border-secondary hover:bg-secondary/5 sm:w-auto"
                  data-scroll-target="#contact"
                  id="hero-secondary-button"
                >
                  Hablemos
                </button>
              </div>

              <div class="mt-5">
                <a
                  id="hero-email"
                  class="inline-flex items-center gap-2 text-sm font-semibold tracking-tight text-on-surface-variant transition hover:text-secondary"
                  href="mailto:jonalopezacevedo@gmail.com"
                >
                  <span class="material-symbols-outlined text-base">mail</span>
                  <span>jonalopezacevedo@gmail.com</span>
                </a>
              </div>

              <div id="hero-link-grid" class="mt-5 grid grid-cols-2 gap-3 lg:flex lg:flex-wrap"></div>
            </div>
          </div>

          <div class="relative order-2 w-full lg:order-none lg:col-span-5">
            <div class="glass-panel relative mx-auto max-w-[30rem] overflow-hidden rounded-[2rem] border border-outline-variant/15 p-4 shadow-[0_35px_120px_rgba(0,0,0,0.35)] lg:max-w-none lg:p-5">
              <div class="visual-panel visual-portrait min-h-[320px] rounded-[1.6rem] sm:min-h-[420px] lg:min-h-[480px]">
                <Image
                  src={portraitImage}
                  alt="Foto de Jonathan Acevedo"
                  class="hero-photo"
                  widths={[720, 960, 1280, 1600, 2048]}
                  sizes="(min-width: 1024px) 38rem, (min-width: 768px) 50vw, 100vw"
                  quality={100}
                  loading="eager"
                  decoding="sync"
                  fetchpriority="high"
                />

                <div class="absolute bottom-3 left-3 right-3 z-10 sm:inset-x-4 sm:bottom-4 lg:inset-x-5 lg:bottom-5">
                  <div class="glass-panel hero-focus-card w-[18rem] max-w-full rounded-[1.05rem] border border-outline-variant/20 px-3.5 py-1.5 text-center sm:w-[20rem] sm:rounded-[1.2rem] sm:px-4 sm:py-2.5 lg:w-[25.5rem] lg:max-w-[25.5rem] lg:px-4.5 lg:py-2.5 xl:w-[27rem] xl:max-w-[27rem]">
                    <p class="text-[0.58rem] font-black uppercase tracking-[0.16em] text-primary sm:text-[0.64rem] sm:tracking-[0.18em]" data-i18n="hero.focusLabel">
                      Enfoque
                    </p>
                    <h2
                      id="hero-focus"
                      class="mx-auto mt-1 max-w-[15.75rem] font-headline text-[0.82rem] font-bold leading-[1.16] text-on-surface sm:mt-1.5 sm:max-w-[17.5rem] sm:text-[0.94rem] sm:leading-[1.18] lg:mt-1.5 lg:max-w-[21rem] lg:text-[1.12rem] lg:leading-[1.12] xl:max-w-[22.5rem] xl:text-[1.2rem]"
                    >
                      Interfaces memorables con estrategia, sistema y detalle.
                    </h2>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="projects" class="px-6 py-16 lg:px-8 lg:py-20">
        <div class="mx-auto max-w-7xl" data-section-anchor>
          <div class="mb-9 flex flex-col gap-5 lg:mb-10 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
            <div>
              <h2 class="text-3xl font-bold tracking-tight text-on-surface sm:text-4xl lg:text-[2.7rem]" data-i18n="projects.title">
                Proyectos destacados
              </h2>
            </div>

            <div id="project-filters" class="flex flex-wrap gap-3">
              <button type="button" class="filter-chip" data-filter="all">Todos</button>
              <button type="button" class="filter-chip" data-filter="web">Web</button>
              <button type="button" class="filter-chip" data-filter="branding">Marca</button>
              <button type="button" class="filter-chip" data-filter="automation">Automatizacion</button>
            </div>
          </div>

          <div id="projects-grid" class="projects-scroll-row custom-scrollbar"></div>
        </div>
      </section>

      <section id="insights" class="border-y border-outline-variant/10 bg-surface-container-low/40 px-6 py-16 lg:px-8 lg:py-20">
        <div class="mx-auto max-w-7xl" data-section-anchor>
          <div class="mb-8 flex flex-col gap-5 lg:mb-9 lg:flex-row lg:items-end lg:justify-between">
            <h2 class="text-4xl font-bold tracking-tight text-on-surface sm:text-5xl" data-i18n="insights.title">
              Notas recientes
            </h2>
            <div id="insights-filters" class="flex flex-wrap gap-3">
              <button type="button" class="filter-chip" data-article-filter="all">Todos</button>
              <button type="button" class="filter-chip" data-article-filter="design">Diseno</button>
              <button type="button" class="filter-chip" data-article-filter="web">Web</button>
              <button type="button" class="filter-chip" data-article-filter="automation">Automatizacion</button>
              <button type="button" class="filter-chip" data-article-filter="content">Contenido</button>
            </div>
          </div>

          <div class="grid gap-5 lg:grid-cols-[minmax(17rem,0.74fr)_minmax(0,1.26fr)] lg:items-start lg:gap-6">
            <div id="articles-list" class="articles-scroll-column custom-scrollbar order-2 lg:order-1"></div>
            <article id="article-feature" class="order-1 lg:order-2 lg:sticky lg:top-28 lg:self-start"></article>
          </div>
        </div>
      </section>

      <section id="about" class="px-6 py-24 lg:px-8">
        <div class="mx-auto max-w-7xl" data-section-anchor>
          <div class="mb-8 flex flex-col gap-5 lg:mb-9 lg:flex-row lg:items-end lg:justify-between">
            <div class="flex flex-col gap-3 lg:max-w-[32rem]">
              <h2 class="text-4xl font-bold tracking-tight text-on-surface sm:text-5xl" data-i18n="about.title">
                Sobre mi
              </h2>
              <p class="max-w-2xl text-sm leading-7 text-on-surface-variant sm:text-base" data-i18n="about.subtitle">
                Esta seccion presenta mis intereses y gustos personales.
              </p>
            </div>
            <div id="about-media-filters" class="flex flex-wrap gap-3">
              <button type="button" class="filter-chip" data-about-filter="all">Todo</button>
              <button type="button" class="filter-chip" data-about-filter="movies">Peliculas</button>
              <button type="button" class="filter-chip" data-about-filter="series">Series</button>
              <button type="button" class="filter-chip" data-about-filter="anime">Animes</button>
              <button type="button" class="filter-chip" data-about-filter="books">Libros</button>
              <button type="button" class="filter-chip" data-about-filter="games">Videojuegos</button>
            </div>
          </div>

          <div class="grid gap-5 lg:grid-cols-[minmax(17rem,0.76fr)_minmax(0,1.24fr)] lg:items-start lg:gap-6">
            <div id="about-media-list" class="articles-scroll-column custom-scrollbar order-2 lg:order-1"></div>
            <article id="about-media-feature" class="order-1 lg:order-2 lg:sticky lg:top-28 lg:self-start"></article>
          </div>
        </div>
      </section>
    </main>

    <footer id="contact" class="relative overflow-hidden border-t border-outline-variant/10 bg-background px-6 py-24 lg:px-8">
      <div class="mx-auto max-w-7xl space-y-8" data-section-anchor>
        <div class="hidden">
          <p class="text-sm font-black uppercase tracking-[0.26em] text-on-surface-variant" id="footer-brand">
            TU NOMBRE
          </p>
          <h2 id="footer-title" class="mt-6 text-4xl font-bold leading-tight tracking-tight text-on-surface sm:text-5xl">
            Construyamos algo <span class="text-gradient-primary">diferente</span>.
          </h2>
          <p id="footer-description" class="mt-6 max-w-xl text-lg leading-8 text-on-surface-variant">
            Disponible para proyectos web, rediseños, landing pages y productos digitales con criterio visual.
          </p>
          <p class="mt-10 text-xs font-black uppercase tracking-[0.22em] text-on-surface-variant/70">
            <span id="footer-year"></span> <span data-i18n="footer.legal">Portafolio personal. Edita el contenido en src/scripts/portfolio.js.</span>
          </p>
        </div>

        <div class="space-y-8">
          <h2 class="text-4xl font-bold tracking-tight text-on-surface sm:text-5xl" data-i18n="contact.title">
            Contáctame
          </h2>

          <div id="contact-grid" class="mx-auto grid max-w-5xl grid-cols-1 gap-3.5 sm:grid-cols-2 xl:grid-cols-5"></div>
          <div class="mx-auto mt-12 max-w-4xl" id="footer-legal-line">
            <p
              class="rounded-[1.45rem] border border-outline-variant/18 bg-surface-container-highest/74 px-5 py-4 text-center text-[0.78rem] font-bold tracking-[0.08em] text-on-surface-variant/90 shadow-[0_18px_40px_rgba(17,5,30,0.16)] sm:px-6 sm:text-sm"
              data-i18n="footer.legalLine"
            >
              © 2026 Jonathan Estiben Acevedo López • Todos los derechos reservados
            </p>
          </div>
          <p
            class="text-center text-[0.68rem] font-black uppercase tracking-[0.2em] text-on-surface-variant/75 sm:text-xs"
            data-i18n="footer.legalLine"
          >
            © 2026 Jonathan Estiben Acevedo López • Todos los derechos reservados
          </p>
        </div>
      </div>
    </footer>

    <script type="module" src={portfolioScript}></script>
  </body>
</html>
