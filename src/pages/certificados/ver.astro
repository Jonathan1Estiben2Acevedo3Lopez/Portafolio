---
import certificates from "../../data/certificates.json";
import "../../styles/global.css";

const baseUrl = import.meta.env.BASE_URL || "/";
const withBase = (path) => `${baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`}${path.replace(/^\//, "")}`;
const toCertificateUrl = (fileName) => {
  const cleanFileName = String(fileName ?? "").trim();

  if (!cleanFileName) {
    return "";
  }

  return withBase(`/certificados/${cleanFileName.split(/[\\/]/).map(encodeURIComponent).join("/")}`);
};
const certificateSources = certificates
  .filter((certificate) => certificate.hidden !== true)
  .map(({ fileName, mime, copy, ...certificate }) => ({
    ...certificate,
    fileName,
    mime,
    source: toCertificateUrl(fileName),
    title: copy?.es?.title ?? copy?.en?.title ?? certificate.id ?? "Certificado",
  }));
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Visor de certificado | Jonathan Acevedo</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="certificate-page bg-background font-body text-on-surface">
    <main class="certificate-page-shell">
      <header class="certificate-page-header">
        <a class="certificate-page-back" href={withBase("/#certificates")}>Volver</a>
        <h1 id="certificate-page-title">Certificado</h1>
        <a
          id="certificate-page-open"
          class="certificate-page-open is-hidden"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
        >
          Abrir original
        </a>
      </header>

      <section class="certificate-page-viewer" id="certificate-page-viewer">
        <div id="certificate-page-content" class="certificate-page-content custom-scrollbar"></div>
      </section>
    </main>

    <script is:inline define:vars={{ certificateSources }}>
      (() => {
        const params = new URLSearchParams(window.location.search);
        const escapeAttribute = (value) => {
          const replacements = {
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          };

          return String(value).replace(/[&<>"']/g, (character) => replacements[character]);
        };

        const selectedCertificate = certificateSources.find((item) => {
          return item.id === params.get("certificate");
        });
        const file = selectedCertificate?.source || "";
        const title = params.get("title") || selectedCertificate?.title || "Certificado";
        const safeTitle = escapeAttribute(title);
        const type = selectedCertificate?.type || "pdf";
        const mime = selectedCertificate?.mime || (type === "pdf" ? "application/pdf" : "");
        const content = document.getElementById("certificate-page-content");
        const titleNode = document.getElementById("certificate-page-title");
        const openLink = document.getElementById("certificate-page-open");

        const allowedFile = Boolean(selectedCertificate?.source);

        const renderPdfCertificate = () => {
          content.classList.add("is-pdf");
          content.classList.remove("is-image");
          content.dataset.pdfSource = file;
          content.dataset.pdfTitle = title;
          content.innerHTML = '<div class="certificate-page-loading" role="status">Ajustando certificado...</div>';
        };

        if (!allowedFile) {
          content.innerHTML = '<div class="certificate-page-error">No se encontro el certificado.</div>';
          openLink?.classList.add("is-hidden");
          return;
        }

        document.title = `${title} | Visor de certificado`;
        titleNode.textContent = title;
        openLink.href = file;
        openLink.classList.remove("is-hidden");

        if (type === "pdf" || mime === "application/pdf") {
          renderPdfCertificate();
        } else {
          const safeFile = escapeAttribute(file);
          content.classList.remove("is-pdf");
          content.classList.add("is-image");
          content.innerHTML = `<img class="certificate-page-image" src="${safeFile}" alt="${safeTitle}" decoding="async" draggable="false" />`;
        }
      })();
    </script>
    <script>
      import * as pdfjsLib from "pdfjs-dist/build/pdf.mjs";
      import pdfJsWorkerUrl from "pdfjs-dist/build/pdf.worker.mjs?url";

      const content = document.getElementById("certificate-page-content");
      const viewer = document.getElementById("certificate-page-viewer");
      const pdfSource = content?.dataset.pdfSource;

      if (content && viewer && pdfSource) {
        pdfjsLib.GlobalWorkerOptions.workerSrc = pdfJsWorkerUrl;

        let pdfDocumentPromise;
        let renderVersion = 0;
        let resizeTimer;

        const showError = () => {
          content.innerHTML = '<div class="certificate-page-error">No se pudo mostrar el certificado.</div>';
        };

        const renderPdf = async () => {
          const currentVersion = ++renderVersion;

          try {
            pdfDocumentPromise ||= pdfjsLib.getDocument({ url: pdfSource }).promise;
            const pdfDocument = await pdfDocumentPromise;

            if (currentVersion !== renderVersion) {
              return;
            }

            const pages = document.createElement("div");
            pages.className = "certificate-pdf-pages";
            pages.classList.toggle("is-single-page", pdfDocument.numPages === 1);
            pages.setAttribute("aria-label", content.dataset.pdfTitle || "Certificado PDF");
            content.replaceChildren(pages);

            const styles = getComputedStyle(pages);
            const horizontalPadding = parseFloat(styles.paddingLeft) + parseFloat(styles.paddingRight);
            const verticalPadding = parseFloat(styles.paddingTop) + parseFloat(styles.paddingBottom);
            const availableWidth = Math.max(content.clientWidth - horizontalPadding, 1);
            const availableHeight = Math.max(content.clientHeight - verticalPadding, 1);
            const outputScale = Math.min(Math.max(window.devicePixelRatio || 1, 2), 4);

            for (let pageNumber = 1; pageNumber <= pdfDocument.numPages; pageNumber += 1) {
              if (currentVersion !== renderVersion) {
                return;
              }

              const page = await pdfDocument.getPage(pageNumber);
              const baseViewport = page.getViewport({ scale: 1 });
              const fitScale = Math.min(
                availableWidth / baseViewport.width,
                availableHeight / baseViewport.height,
              );
              const cssViewport = page.getViewport({ scale: fitScale });
              const renderViewport = page.getViewport({ scale: fitScale * outputScale });
              const pageElement = document.createElement("div");
              const canvas = document.createElement("canvas");
              const context = canvas.getContext("2d", { alpha: false });

              if (!context) {
                throw new Error("Canvas no disponible");
              }

              context.imageSmoothingEnabled = true;
              context.imageSmoothingQuality = "high";
              pageElement.className = "certificate-pdf-page";
              canvas.className = "certificate-pdf-canvas";
              canvas.width = Math.ceil(renderViewport.width);
              canvas.height = Math.ceil(renderViewport.height);
              canvas.style.width = `${Math.floor(cssViewport.width)}px`;
              canvas.style.height = `${Math.floor(cssViewport.height)}px`;
              canvas.setAttribute("aria-label", `Pagina ${pageNumber} de ${pdfDocument.numPages}`);
              pageElement.appendChild(canvas);
              pages.appendChild(pageElement);

              await page.render({ canvasContext: context, viewport: renderViewport }).promise;
            }
          } catch (error) {
            if (currentVersion === renderVersion) {
              showError();
            }
          }
        };

        const resizeObserver = new ResizeObserver(() => {
          window.clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(renderPdf, 140);
        });

        resizeObserver.observe(viewer);
        renderPdf();
      }
    </script>
  </body>
</html>
