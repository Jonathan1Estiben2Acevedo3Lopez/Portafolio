---
import { projectDetails } from "../../data/project-details";
import "../../styles/global.css";

export function getStaticPaths() {
  return projectDetails.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const defaultCopy = project.locales?.es ?? project;
const relatedProjects = projectDetails.filter((item) => item.slug !== project.slug).slice(0, 2);
const relatedProjectCards = relatedProjects.map((item) => ({
  slug: item.slug,
  href: item.href || `/proyectos/${item.slug}`,
  previewImage: item.previewImage,
  visualClass: item.visualClass,
  year: item.year,
  locales: item.locales,
}));
const baseUrl = import.meta.env.BASE_URL || "/";
const withBase = (path) => `${baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`}${path.replace(/^\//, "")}`;
const isExternalAsset = (path) => /^(https?:)?\/\//.test(path) || path.startsWith("data:") || path.startsWith("blob:");
const assetUrl = (path) => (path && isExternalAsset(path) ? path : path ? withBase(path) : "");
const heroImage = defaultCopy.previewImage ?? project.previewImage ?? defaultCopy.media?.images?.[0]?.src;
const heroImageAlt = `Vista previa de ${defaultCopy.title}`;
const dynamicModules = (defaultCopy.modulesOrder || [])
  .map((id) => ({ id, ...(defaultCopy.modules?.[id] || {}) }))
  .filter((module) => {
    return module.body || module.code || module.items?.length || module.links?.length;
  });
const youtube = defaultCopy.media?.youtube;
const youtubeEmbedUrl = youtube?.youtubeId
  ? `https://www.youtube.com/embed/${youtube.youtubeId}`
  : youtube?.playlistId
    ? `https://www.youtube.com/embed/videoseries?list=${youtube.playlistId}`
    : "";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{defaultCopy.title} | Jonathan Acevedo</title>
    <meta name="description" content={defaultCopy.summary} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        if ("scrollRestoration" in window.history) {
          window.history.scrollRestoration = "manual";
        }

        const storedTheme = window.localStorage.getItem("portfolio-theme");
        const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = storedTheme || (systemPrefersDark ? "dark" : "light");

        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.classList.toggle("light", theme === "light");
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.add("supports-detail-reveal");
      })();
    </script>
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body class="bg-background font-body text-on-surface selection:bg-secondary/30">
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="orb orb-primary"></div>
      <div class="orb orb-secondary"></div>
      <div class="grid-overlay"></div>
    </div>

    <header class="sticky top-0 z-50 px-3 pt-3 lg:px-4">
      <nav class="site-shell site-shell--nav mx-auto flex max-w-7xl items-center justify-between rounded-[1.7rem] border border-outline-variant/15 bg-background/72 px-5 py-3 shadow-[0_18px_54px_rgba(0,0,0,0.24)] backdrop-blur-xl lg:px-7">
        <a
          id="detail-back-link"
          href={withBase("/#projects")}
          class="inline-flex items-center gap-2 rounded-full border border-outline-variant/20 bg-surface-container-highest/50 px-4 py-2 text-sm font-bold tracking-tight text-on-surface transition hover:border-secondary hover:text-secondary"
        >
          <span class="material-symbols-outlined text-[1.15rem]">arrow_back</span>
          <span id="detail-back-label">Volver al portafolio</span>
        </a>

        <div class="flex items-center gap-3">
          <button
            type="button"
            id="detail-language-toggle"
            class="inline-flex min-h-10 items-center justify-center rounded-full border border-outline-variant/20 bg-surface-container-highest/50 px-4 text-sm font-black tracking-tight text-on-surface transition hover:border-secondary hover:text-secondary"
            aria-label="Cambiar a ingles"
            title="Cambiar a ingles"
          >
            English
          </button>
          <button
            type="button"
            id="detail-theme-toggle"
            class="theme-toggle border border-outline-variant/20 bg-surface-container-highest/50 text-on-surface transition hover:border-secondary hover:text-secondary"
            aria-label="Cambiar a modo claro"
            title="Cambiar a modo claro"
          >
            <span class="theme-toggle-icon" id="detail-theme-toggle-icon" aria-hidden="true"></span>
          </button>
        </div>
      </nav>
    </header>

    <main class={`detail-page-main ${project.visualTemplate ? `detail-template-${project.visualTemplate}` : ""} px-4 pb-20 pt-5 sm:px-6 lg:px-8 lg:pt-6`}>
      <section class="detail-hero-grid detail-reveal site-shell site-shell--main mx-auto grid max-w-7xl gap-5 lg:grid-cols-12 lg:items-start lg:gap-8" data-detail-reveal>
        <div class="detail-hero-copy lg:col-span-7">
          <p id="detail-kicker" class="detail-kicker">
            {defaultCopy.accent} - {project.year}
          </p>
          <h1 id="detail-title" class="detail-display mt-3 max-w-4xl font-headline text-4xl font-bold leading-[1.02] tracking-tight text-on-surface sm:text-5xl lg:text-6xl">
            {defaultCopy.title}
          </h1>
          <p id="detail-summary" class="detail-summary mt-4 max-w-3xl text-base leading-7 text-on-surface-variant sm:text-lg sm:leading-8">
            {defaultCopy.summary}
          </p>

          <div class="detail-brief-grid mt-5 grid gap-4 sm:grid-cols-3">
            <div class="detail-brief-card glass-panel">
              <span class="material-symbols-outlined detail-brief-icon" aria-hidden="true">category</span>
              <p id="detail-category-label" class="detail-label">Categoria</p>
              <p id="detail-category-value" class="mt-3 text-sm font-semibold text-on-surface">{defaultCopy.category}</p>
            </div>
            <div class="detail-brief-card glass-panel">
              <span class="material-symbols-outlined detail-brief-icon" aria-hidden="true">view_quilt</span>
              <p id="detail-format-label" class="detail-label">Formato</p>
              <p id="detail-format-value" class="mt-3 text-sm font-semibold text-on-surface">{defaultCopy.tag}</p>
            </div>
            <div class="detail-brief-card glass-panel">
              <span class="material-symbols-outlined detail-brief-icon" aria-hidden="true">neurology</span>
              <p id="detail-focus-label" class="detail-label">Enfoque</p>
              <p id="detail-focus-value" class="mt-3 text-sm font-semibold text-on-surface">{defaultCopy.accent}</p>
            </div>
          </div>

          <div id="detail-metrics" class="detail-metrics-grid mt-4 grid gap-4 sm:grid-cols-3"></div>

          <div id="detail-links" class="mt-5 flex flex-wrap gap-3"></div>
        </div>

        <div class="detail-hero-media lg:col-span-5">
          <div class="detail-hero-media-panel glass-panel">
            <div class="detail-device-frame">
              <div class="detail-device-toolbar" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
                <strong id="detail-device-title">{defaultCopy.title}</strong>
              </div>
              {heroImage ? (
                <div id="detail-hero-visual" class="project-visual project-live-visual detail-hero-visual detail-adaptive-image-frame relative overflow-hidden rounded-[1.25rem] border border-outline-variant/15 bg-white">
                  <img
                    id="detail-hero-image"
                    src={assetUrl(heroImage)}
                    alt={heroImageAlt}
                    loading="eager"
                    class="project-preview-image"
                  />
                </div>
              ) : (
                <div id="detail-hero-visual" class={`project-visual ${project.visualClass} detail-hero-visual min-h-[320px] rounded-[1.25rem] sm:min-h-[380px]`}></div>
              )}
            </div>
            <div class="detail-floating-note detail-floating-note--bottom" aria-hidden="true">
              <span class="material-symbols-outlined">timeline</span>
              <span>{project.year}</span>
            </div>
          </div>
        </div>
      </section>

      <nav class="detail-story-nav site-shell site-shell--main mx-auto mt-8 max-w-7xl" aria-label="Navegacion de ficha">
        <a href="#detail-overview-section" data-detail-nav="context">Contexto</a>
        <a href="#detail-process-section" data-detail-nav="process">Proceso</a>
        <a href="#detail-results-section" data-detail-nav="impact">Impacto</a>
        <a href="#detail-images-section" data-detail-nav="visuals">Visuales</a>
        {project.liveUrl ? <a href="#detail-live-section" data-detail-nav="live">Demo</a> : null}
      </nav>

      <section class="detail-story-layout site-shell site-shell--main mx-auto mt-12 grid max-w-7xl gap-8 lg:grid-cols-12">
        <div class="space-y-8 lg:col-span-7">
          <article id="detail-overview-section" class="detail-feature-card detail-reveal glass-panel" data-detail-reveal>
            <div class="detail-card-heading">
              <span class="material-symbols-outlined" aria-hidden="true">explore</span>
              <p id="detail-overview-label" class="detail-section-label">Resumen</p>
            </div>
            <p id="detail-overview" class="mt-5 text-base leading-8 text-on-surface-variant">{defaultCopy.overview}</p>
          </article>

          <article id="detail-long-description-section" class="detail-feature-card detail-reveal glass-panel" hidden={!defaultCopy.longDescription} data-detail-reveal>
            <div class="detail-card-heading">
              <span class="material-symbols-outlined" aria-hidden="true">article</span>
              <p id="detail-long-description-label" class="detail-section-label">Descripcion</p>
            </div>
            <p id="detail-long-description" class="mt-5 whitespace-pre-line text-base leading-8 text-on-surface-variant">{defaultCopy.longDescription}</p>
          </article>

          <div class="grid gap-6 md:grid-cols-2">
            <article id="detail-challenge-section" class="detail-duo-card detail-reveal glass-panel" data-detail-reveal>
              <div class="detail-card-heading">
                <span class="material-symbols-outlined" aria-hidden="true">flag</span>
                <p id="detail-challenge-label" class="detail-section-label">Reto</p>
              </div>
              <p id="detail-challenge" class="mt-5 text-base leading-8 text-on-surface-variant">{defaultCopy.challenge}</p>
            </article>

            <article id="detail-solution-section" class="detail-duo-card detail-reveal glass-panel" data-detail-reveal>
              <div class="detail-card-heading">
                <span class="material-symbols-outlined" aria-hidden="true">route</span>
                <p id="detail-solution-label" class="detail-section-label">Solucion</p>
              </div>
              <p id="detail-solution" class="mt-5 text-base leading-8 text-on-surface-variant">{defaultCopy.solution}</p>
            </article>
          </div>

          <section id="detail-results-section" class="detail-feature-card detail-reveal glass-panel" data-detail-reveal>
            <div class="detail-card-heading">
              <span class="material-symbols-outlined" aria-hidden="true">monitoring</span>
              <p id="detail-results-title" class="detail-section-label">Resultados</p>
            </div>
            <p id="detail-results-body" class="mt-5 whitespace-pre-line text-base leading-8 text-on-surface-variant"></p>
          </section>
        </div>

        <aside class="detail-insight-rail space-y-8 lg:col-span-5">
          <section id="detail-stack-section" class="detail-side-card detail-reveal glass-panel" data-detail-reveal>
            <div class="detail-card-heading">
              <span class="material-symbols-outlined" aria-hidden="true">deployed_code</span>
              <p id="detail-stack-title" class="detail-section-label">Stack</p>
            </div>
            <div id="detail-stack-list" class="mt-5 flex flex-wrap gap-3"></div>
          </section>

          <section id="detail-process-section" class="detail-timeline-section detail-reveal glass-panel" data-detail-reveal>
            <div class="detail-card-heading">
              <span class="material-symbols-outlined" aria-hidden="true">conversion_path</span>
              <p id="detail-process-title" class="detail-section-label">Proceso</p>
            </div>
            <div id="detail-process-list" class="detail-timeline-list mt-7 grid gap-4"></div>
          </section>

          <section id="detail-deliverables-section" class="detail-side-card detail-reveal glass-panel" data-detail-reveal>
            <div class="detail-card-heading">
              <span class="material-symbols-outlined" aria-hidden="true">task_alt</span>
              <p id="detail-deliverables-title" class="detail-section-label">Entregables</p>
            </div>
            <ul id="detail-deliverables-list" class="mt-5 space-y-3 text-sm leading-7 text-on-surface-variant"></ul>
          </section>

          <section id="detail-learnings-section" class="detail-side-card detail-reveal glass-panel" data-detail-reveal>
            <div class="detail-card-heading">
              <span class="material-symbols-outlined" aria-hidden="true">psychology</span>
              <p id="detail-learnings-title" class="detail-section-label">Aprendizajes</p>
            </div>
            <ul id="detail-learnings-list" class="mt-5 space-y-3 text-sm leading-7 text-on-surface-variant"></ul>
          </section>
        </aside>

        <div id="detail-ordered-sections" class="detail-ordered-sections">
          <section id="detail-images-section" class="detail-gallery-section detail-carousel-section detail-reveal glass-panel lg:col-span-12" data-detail-reveal>
            <div class="detail-carousel-heading">
              <div>
                <p id="detail-images-eyebrow" class="detail-section-label">Capturas</p>
                <h2 id="detail-images-title" class="mt-3 font-headline text-2xl font-bold tracking-tight text-on-surface">Galeria del proyecto</h2>
              </div>
              <div class="detail-carousel-controls" aria-label="Controles de imagenes">
                <button type="button" class="detail-carousel-button" data-carousel-target="detail-images-grid" data-carousel-direction="-1" aria-label="Imagen anterior">
                  <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                </button>
                <button type="button" class="detail-carousel-button" data-carousel-target="detail-images-grid" data-carousel-direction="1" aria-label="Imagen siguiente">
                  <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                </button>
              </div>
            </div>
            <div id="detail-images-grid" class="detail-carousel-row custom-scrollbar"></div>
          </section>

          <section id="detail-videos-section" class="detail-media-section detail-carousel-section detail-reveal glass-panel lg:col-span-12" data-detail-reveal>
            <div class="detail-carousel-heading">
              <p id="detail-videos-title" class="detail-section-label">Videos</p>
              <div class="detail-carousel-controls" aria-label="Controles de videos">
                <button type="button" class="detail-carousel-button" data-carousel-target="detail-videos-grid" data-carousel-direction="-1" aria-label="Video anterior">
                  <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                </button>
                <button type="button" class="detail-carousel-button" data-carousel-target="detail-videos-grid" data-carousel-direction="1" aria-label="Video siguiente">
                  <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                </button>
              </div>
            </div>
            <div id="detail-videos-grid" class="detail-carousel-row custom-scrollbar"></div>
          </section>

          <section id="detail-youtube-section" class="detail-media-section detail-reveal glass-panel lg:col-span-12" hidden={!youtubeEmbedUrl} data-detail-reveal>
            <p id="detail-youtube-title" class="detail-section-label">Video</p>
            <div class="mt-6 overflow-hidden rounded-[1.5rem] border border-outline-variant/15 bg-black">
              <iframe
                id="detail-youtube-frame"
                src={youtubeEmbedUrl}
                title={`Video de ${defaultCopy.title}`}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                class="aspect-video w-full"
              ></iframe>
            </div>
          </section>

          <section id="detail-dynamic-modules-section" class="detail-modules-section detail-reveal glass-panel lg:col-span-12" hidden={dynamicModules.length === 0} data-detail-reveal>
            <p id="detail-dynamic-modules-title" class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Modulos</p>
            <div id="detail-dynamic-modules-list" class="detail-module-grid mt-6 grid gap-4">
              {dynamicModules.map((module) => (
                <article class="detail-module-card">
                  <p class="detail-label">{module.label || module.id}</p>
                  <h3 class="mt-3 font-headline text-xl font-bold tracking-tight text-on-surface">{module.title || module.id}</h3>
                  {module.body ? <p class="mt-3 whitespace-pre-line text-sm leading-7 text-on-surface-variant">{module.body}</p> : null}
                  {module.code ? <pre class="mt-4 overflow-auto rounded-[1rem] bg-black/55 p-4 text-xs leading-6 text-on-surface"><code>{module.code}</code></pre> : null}
                </article>
              ))}
            </div>
          </section>

          <section id="detail-collaborators-section" class="detail-modules-section detail-reveal glass-panel lg:col-span-12" hidden data-detail-reveal>
            <p id="detail-collaborators-title" class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Colaboradores</p>
            <div id="detail-collaborators-list" class="detail-collaborators-grid mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3"></div>
          </section>
        </div>
      </section>

      {project.liveUrl ? (
        <section id="detail-live-section" class="site-shell site-shell--main mx-auto mt-12 max-w-7xl">
          <div class="detail-live-panel detail-reveal glass-panel" data-detail-reveal>
            <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
              <div class="max-w-3xl">
                <p id="detail-live-eyebrow" class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Vista interactiva</p>
                <h2 id="detail-live-title" class="mt-3 font-headline text-2xl font-bold tracking-tight text-on-surface sm:text-3xl">
                  {defaultCopy.interactiveTitle}
                </h2>
                <p id="detail-live-description" class="mt-4 text-sm leading-7 text-on-surface-variant sm:text-base">
                  {defaultCopy.interactiveDescription}
                </p>
              </div>

              <div class="flex flex-col gap-3 sm:flex-row">
                <a
                  id="detail-open-live"
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center rounded-2xl bg-primary px-5 py-3 text-sm font-bold tracking-tight text-on-primary transition hover:-translate-y-0.5"
                >
                  Abrir en pestana nueva
                </a>
                <a
                  id="detail-contact-cta"
                  href={withBase("/#contact")}
                  class="inline-flex items-center justify-center rounded-2xl border border-secondary/25 px-5 py-3 text-sm font-bold tracking-tight text-secondary transition hover:border-secondary hover:bg-secondary/5"
                >
                  Hablar del proyecto
                </a>
              </div>
            </div>

            <div class="mt-6 overflow-hidden rounded-[1.7rem] border border-outline-variant/18 bg-white shadow-[0_22px_60px_rgba(8,16,38,0.22)]">
              <div class="flex items-center gap-2 border-b border-slate-200 bg-slate-100 px-4 py-3">
                <span class="h-3 w-3 rounded-full bg-rose-400"></span>
                <span class="h-3 w-3 rounded-full bg-amber-400"></span>
                <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
                <span id="detail-iframe-url" class="ml-3 min-w-0 truncate rounded-full bg-white px-3 py-1 text-xs font-semibold tracking-tight text-slate-500">
                  {project.liveUrl}
                </span>
              </div>

              <iframe
                src={project.liveUrl}
                title={`Demo interactiva de ${defaultCopy.title}`}
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                sandbox="allow-forms allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts"
                allow="fullscreen"
                class="h-[34rem] w-full bg-white sm:h-[38rem] lg:h-[46rem]"
              ></iframe>
            </div>

            <p id="detail-live-note" class="mt-4 text-xs font-semibold tracking-tight text-on-surface-variant sm:text-sm">
              Si tu navegador bloquea la vista embebida, puedes abrir el proyecto en una pestana nueva con el boton superior.
            </p>
          </div>
        </section>
      ) : null}

      <section class="site-shell site-shell--main mx-auto mt-12 max-w-7xl">
        <div class="mb-6 flex items-center justify-between gap-4">
          <h2 id="detail-related-title" class="font-headline text-2xl font-bold tracking-tight text-on-surface sm:text-3xl">Otros proyectos</h2>
          <a
            id="detail-related-link"
            href={withBase("/#projects")}
            class="text-sm font-bold tracking-tight text-secondary transition hover:text-on-surface"
          >
            Ver todos
          </a>
        </div>

        <div id="detail-related-grid" class="grid gap-6 lg:grid-cols-2"></div>
      </section>
    </main>

    <div id="detail-gallery-lightbox" class="detail-gallery-lightbox" role="dialog" aria-modal="true" aria-label="Imagen ampliada" aria-hidden="true" hidden>
      <figure class="detail-gallery-lightbox-frame">
        <button id="detail-gallery-lightbox-close" type="button" class="detail-gallery-lightbox-close" data-gallery-close aria-label="Cerrar imagen">
          <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
        <img id="detail-gallery-lightbox-image" src="" alt="" />
        <figcaption id="detail-gallery-lightbox-caption" class="detail-gallery-lightbox-caption" hidden></figcaption>
      </figure>
    </div>

    <script define:vars={{ projectLocales: project.locales, relatedProjectCards, baseUrl, projectYear: project.year, projectPreviewImage: project.previewImage, projectVisualClass: project.visualClass, projectLiveUrl: project.liveUrl, isStudioPreview: project.slug === "studio-preview" }}>
      (() => {
        const labels = {
          es: {
            back: "Volver al portafolio",
            languageToggle: "English",
            languageTitle: "Cambiar a ingles",
            themeToDark: "Cambiar a modo oscuro",
            themeToLight: "Cambiar a modo claro",
            category: "Categoria",
            format: "Formato",
            focus: "Enfoque",
            overview: "Resumen",
            longDescription: "Descripcion",
            challenge: "Reto",
            solution: "Solucion",
            process: "Proceso",
            imagesEyebrow: "Capturas",
            imagesTitle: "Galeria del proyecto",
            videos: "Videos",
            youtube: "Video",
            dynamicModules: "Modulos",
            results: "Resultados",
            stack: "Stack",
            deliverables: "Entregables",
            learnings: "Aprendizajes",
            collaborators: "Colaboradores",
            liveEyebrow: "Vista interactiva",
            openLive: "Abrir en pestana nueva",
            contact: "Hablar del proyecto",
            liveNote: "Si tu navegador bloquea la vista embebida, puedes abrir el proyecto en una pestana nueva con el boton superior.",
            related: "Otros proyectos",
            viewAll: "Ver todos",
            imageFallback: "Captura del proyecto",
            navContext: "Contexto",
            navProcess: "Proceso",
            navImpact: "Impacto",
            navVisuals: "Visuales",
            navLive: "Demo",
          },
          en: {
            back: "Back to portfolio",
            languageToggle: "Espanol",
            languageTitle: "Switch to Spanish",
            themeToDark: "Switch to dark mode",
            themeToLight: "Switch to light mode",
            category: "Category",
            format: "Format",
            focus: "Focus",
            overview: "Overview",
            longDescription: "Description",
            challenge: "Challenge",
            solution: "Solution",
            process: "Process",
            imagesEyebrow: "Screenshots",
            imagesTitle: "Project gallery",
            videos: "Videos",
            youtube: "Video",
            dynamicModules: "Modules",
            results: "Results",
            stack: "Stack",
            deliverables: "Deliverables",
            learnings: "Learnings",
            collaborators: "Collaborators",
            liveEyebrow: "Live preview",
            openLive: "Open in new tab",
            contact: "Discuss the project",
            liveNote: "If your browser blocks the embedded view, open the project in a new tab with the button above.",
            related: "Related projects",
            viewAll: "View all",
            imageFallback: "Project screenshot",
            navContext: "Context",
            navProcess: "Process",
            navImpact: "Impact",
            navVisuals: "Visuals",
            navLive: "Demo",
          },
        };

        const themeToggle = document.getElementById("detail-theme-toggle");
        const themeToggleIcon = document.getElementById("detail-theme-toggle-icon");
        const languageToggle = document.getElementById("detail-language-toggle");

        const themeIconMarkup = {
          dark: `
            <svg class="icon-symbol theme-toggle-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2.2"></path>
              <path d="M12 19.8V22"></path>
              <path d="m4.93 4.93 1.56 1.56"></path>
              <path d="m17.51 17.51 1.56 1.56"></path>
              <path d="M2 12h2.2"></path>
              <path d="M19.8 12H22"></path>
              <path d="m4.93 19.07 1.56-1.56"></path>
              <path d="m17.51 6.49 1.56-1.56"></path>
            </svg>
          `,
          light: `
            <svg class="icon-symbol theme-toggle-glyph" viewBox="0 0 24 24" fill="currentColor">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7.2 7.2 0 1 0 9.8 9.8Z"></path>
            </svg>
          `,
        };

        const state = {
          theme: document.documentElement.dataset.theme || window.localStorage.getItem("portfolio-theme") || "dark",
          lang: window.localStorage.getItem("portfolio-lang") === "en" ? "en" : "es",
        };
        let revealObserver = null;
        let liveProjectLocales = projectLocales;
        let liveProjectYear = projectYear;
        let liveProjectPreviewImage = projectPreviewImage;
        let liveProjectVisualClass = projectVisualClass;
        let liveProjectLiveUrl = projectLiveUrl;
        let lastStudioPreviewSignature = "";

        const refreshRevealAnimations = () => {
          const elements = [...document.querySelectorAll("[data-detail-reveal]")];

          if (!("IntersectionObserver" in window)) {
            elements.forEach((element) => element.classList.add("is-visible"));
            return;
          }

          if (!revealObserver) {
            revealObserver = new IntersectionObserver(
              (entries) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    entry.target.classList.add("is-visible");
                    revealObserver.unobserve(entry.target);
                  }
                });
              },
              { rootMargin: "0px 0px -12% 0px", threshold: 0.14 },
            );
          }

          elements.forEach((element, index) => {
            if (element.dataset.detailObserved === "true") {
              return;
            }

            element.style.setProperty("--reveal-delay", `${Math.min(index, 7) * 55}ms`);
            element.dataset.detailObserved = "true";
            revealObserver.observe(element);
          });
        };

        const scheduleRevealAnimations = () => {
          if (typeof window.requestAnimationFrame === "function") {
            window.requestAnimationFrame(refreshRevealAnimations);
            return;
          }

          window.setTimeout(refreshRevealAnimations, 0);
        };

        const escapeHtml = (value = "") =>
          String(value)
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");

        const withBase = (path = "") => {
          if (!path) {
            return "";
          }

          if (/^(https?:)?\/\//.test(path) || path.startsWith("data:") || path.startsWith("blob:") || path.startsWith("mailto:")) {
            return path;
          }

          const normalizedBase = baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`;
          return `${normalizedBase}${path.replace(/^\/+/, "")}`;
        };

        const syncAdaptiveImageFrames = (root = document) => {
          root.querySelectorAll(".detail-adaptive-image-frame .project-preview-image").forEach((image) => {
            const applyRatio = () => {
              const frame = image.closest(".detail-adaptive-image-frame");
              if (!frame || !image.naturalWidth || !image.naturalHeight) {
                return;
              }

              frame.style.setProperty("--preview-image-ratio-number", String(image.naturalWidth / image.naturalHeight));
            };

            if (image.complete) {
              applyRatio();
              return;
            }

            image.addEventListener("load", applyRatio, { once: true });
          });
        };

        const hasText = (value) => typeof value === "string" && value.trim().length > 0;
        const pickText = (primary, fallback = "") => (hasText(primary) ? primary : fallback);
        const pickLocalized = (value, lang, fallback = "") => {
          if (typeof value === "string") {
            return pickText(value, fallback);
          }

          if (!value) {
            return fallback;
          }

          return pickText(value[lang], pickText(value.es, fallback));
        };
        const pickField = (current, fallback, key, defaultValue = "") =>
          pickText(current?.[key], pickText(fallback?.[key], defaultValue));
        const pickArray = (current, fallback, key) => {
          const currentValue = current?.[key];
          const fallbackValue = fallback?.[key];

          if (Array.isArray(currentValue) && currentValue.length > 0) {
            return currentValue;
          }

          return Array.isArray(fallbackValue) ? fallbackValue : [];
        };
        const pickResultText = (current, fallback) => {
          const currentValue = current?.results;
          const fallbackValue = fallback?.results;

          if (Array.isArray(currentValue) && currentValue.length > 0) {
            return currentValue.join("\n");
          }

          if (hasText(currentValue)) {
            return currentValue;
          }

          if (Array.isArray(fallbackValue) && fallbackValue.length > 0) {
            return fallbackValue.join("\n");
          }

          return hasText(fallbackValue) ? fallbackValue : "";
        };
        const normalizeCollaborators = (detail, lang) =>
          Array.isArray(detail.collaborators)
            ? detail.collaborators
                .filter((collaborator) => hasText(collaborator?.name))
                .map((collaborator) => ({
                  name: collaborator.name,
                  role: pickLocalized(collaborator.role, lang, ""),
                  photo: collaborator.photo || "",
                  portfolioUrl: collaborator.portfolioUrl || "",
                  githubUrl: collaborator.githubUrl || "",
                  linkedinUrl: collaborator.linkedinUrl || "",
                }))
            : [];
        const defaultSectionOrder = ["images", "videos", "modules"];
        const normalizeSectionOrder = (value) => {
          const order = Array.isArray(value) ? value.filter((item) => defaultSectionOrder.includes(item)) : [];

          return [...order, ...defaultSectionOrder.filter((item) => !order.includes(item))];
        };

        const previewLinkLabels = {
          es: {
            demo: "Abrir demo",
            repo: "Repositorio",
            docs: "Documentacion",
            video: "Ver video",
            custom: "Abrir enlace",
          },
          en: {
            demo: "Open demo",
            repo: "Repository",
            docs: "Documentation",
            video: "Watch video",
            custom: "Open link",
          },
        };

        const normalizePreviewModuleItem = (item, lang) => {
          if (typeof item === "string") {
            return item;
          }

          if (!item || typeof item !== "object") {
            return "";
          }

          return {
            ...item,
            title: pickLocalized(item.title, lang, typeof item.title === "string" ? item.title : ""),
            label: pickLocalized(item.label, lang, typeof item.label === "string" ? item.label : ""),
            description: pickLocalized(item.description, lang, typeof item.description === "string" ? item.description : ""),
            value: item.value || "",
          };
        };

        const fallbackPreviewModules = (detail = {}) => {
          const modules = {};
          const modulesOrder = [];

          if (Array.isArray(detail.modules)) {
            detail.modules.forEach((module, index) => {
              if (!module || typeof module !== "object") {
                return;
              }

              const id = `studio-module-${index + 1}`;
              modules[id] = {
                label: "Modulo",
                title: module.title || `Modulo ${index + 1}`,
                body: module.body || module.description || "",
              };
              modulesOrder.push(id);
            });
          }

          if (Array.isArray(detail.flow) && detail.flow.length > 0) {
            modules.timeline = {
              label: "Flujo",
              title: "Flujo",
              body: "Linea de tiempo del recorrido o proceso del proyecto.",
              items: detail.flow.map((step) => ({
                label: step.step,
                title: step.title,
                description: step.description,
              })),
            };
            modulesOrder.push("timeline");
          }

          return { modules, modulesOrder };
        };

        const normalizePreviewModules = (modules, lang) => {
          if (!modules || typeof modules !== "object") {
            return {};
          }

          return Object.entries(modules).reduce((accumulator, [id, module]) => {
            if (!module || typeof module !== "object") {
              return accumulator;
            }

            accumulator[id] = {
              ...module,
              label: pickLocalized(module.label, lang, typeof module.label === "string" ? module.label : ""),
              title: pickLocalized(module.title, lang, typeof module.title === "string" ? module.title : id),
              body: pickLocalized(module.body, lang, typeof module.body === "string" ? module.body : ""),
              items: Array.isArray(module.items)
                ? module.items.map((item) => normalizePreviewModuleItem(item, lang)).filter(Boolean)
                : [],
              links: Array.isArray(module.links)
                ? module.links.map((link) => ({
                    ...link,
                    label: pickLocalized(link.label, lang, typeof link.label === "string" ? link.label : link.href),
                  }))
                : [],
            };

            return accumulator;
          }, {});
        };

        const buildPreviewLocale = (project, lang) => {
          const copy = project.copy?.[lang] || project.copy?.es || {};
          const fallbackCopy = project.copy?.es || {};
          const detail = project.detail || {};
          const detailEs = detail.es || {};
          const detailLang = detail[lang] || {};
          const title = pickField(detailLang, detailEs, "title", pickText(copy.title, pickText(fallbackCopy.title, project.slug)));
          const accent = pickField(detailLang, detailEs, "accent", pickText(copy.accent, fallbackCopy.accent || ""));
          const tag = pickField(detailLang, detailEs, "tag", pickText(copy.tag, fallbackCopy.tag || ""));
          const summary = pickField(detailLang, detailEs, "summary", pickText(copy.description, fallbackCopy.description || ""));
          const media = detail.media || {};
          const fallbackModules = fallbackPreviewModules(detail);
          const hasProjectModules = project.modules && Object.keys(project.modules).length > 0;
          const modules = hasProjectModules ? project.modules : fallbackModules.modules;
          const modulesOrder =
            Array.isArray(project.modulesOrder) && project.modulesOrder.length > 0 ? project.modulesOrder : fallbackModules.modulesOrder;

          return {
            title,
            accent,
            tag,
            description: pickText(copy.description, fallbackCopy.description || summary),
            category: pickLocalized(detail.category, lang, project.category || ""),
            summary,
            overview: pickField(detailLang, detailEs, "overview"),
            longDescription: pickField(detailLang, detailEs, "longDescription"),
            challenge: pickField(detailLang, detailEs, "challenge"),
            solution: pickField(detailLang, detailEs, "solution"),
            process: pickArray(detailLang, detailEs, "process"),
            results: pickResultText(detailLang, detailEs),
            deliverables: pickArray(detailLang, detailEs, "deliverables"),
            learnings: pickArray(detailLang, detailEs, "learnings"),
            interactiveTitle: pickField(detailLang, detailEs, "interactiveTitle", title),
            interactiveDescription: pickField(detailLang, detailEs, "interactiveDescription"),
            stack: Array.isArray(detail.stack) ? detail.stack : [],
            metrics: Array.isArray(detail.metrics)
              ? detail.metrics.map((metric) => ({
                  ...metric,
                  label: pickLocalized(metric.label, lang, typeof metric.label === "string" ? metric.label : ""),
                }))
              : [],
            collaborators: normalizeCollaborators(detail, lang),
            previewImage: detail.previewImage || project.previewImage || "",
            links: (Array.isArray(detail.links) ? detail.links : [])
              .filter((link) => hasText(link?.href))
              .map((link) => {
                const type = link.type || "custom";

                return {
                  type,
                  href: link.href,
                  label: pickLocalized(link.label, lang, previewLinkLabels[lang][type] || previewLinkLabels[lang].custom),
                };
              }),
            media: {
              images: (Array.isArray(media.images) ? media.images : [])
                .filter((image) => hasText(image?.src))
                .map((image, index) => ({
                  src: image.src,
                  alt: pickLocalized(image.alt, lang, `${title} ${labels[lang].imageFallback} ${index + 1}`),
                  caption: pickLocalized(image.caption, lang, ""),
                })),
              videos: (Array.isArray(media.videos) ? media.videos : [])
                .filter((video) => hasText(video?.src))
                .map((video, index) => ({
                  src: video.src,
                  poster: video.poster,
                  title: pickLocalized(video.title, lang, `${title} video ${index + 1}`),
                  caption: pickLocalized(video.caption, lang, ""),
                })),
              youtube: null,
            },
            modules: normalizePreviewModules(modules, lang),
            modulesOrder: modulesOrder.filter((id) => modules[id]),
            sectionOrder: normalizeSectionOrder(project.sectionOrder || detail.sectionOrder),
          };
        };

        const applyStudioPreviewProject = (project) => {
          liveProjectLocales = {
            es: buildPreviewLocale(project, "es"),
            en: buildPreviewLocale(project, "en"),
          };
          liveProjectYear = project.year || "";
          liveProjectPreviewImage = project.detail?.previewImage || project.previewImage || "";
          liveProjectVisualClass = project.detail?.visualClass || project.visualClass || liveProjectVisualClass;
          liveProjectLiveUrl = project.detail?.liveUrl || project.liveUrl || "";
          applyLanguage(state.lang, false);
        };

        const refreshStudioPreview = async () => {
          if (!isStudioPreview) {
            return;
          }

          try {
            const response = await fetch(`${withBase("/project-studio-preview.json")}?t=${Date.now()}`, {
              cache: "no-store",
            });

            if (!response.ok) {
              return;
            }

            const project = await response.json();
            const signature = JSON.stringify(project);

            if (signature === lastStudioPreviewSignature) {
              return;
            }

            lastStudioPreviewSignature = signature;
            applyStudioPreviewProject(project);
          } catch {
            // El preview local puede no existir todavia al abrir la ruta por primera vez.
          }
        };

        const setText = (id, value) => {
          const element = document.getElementById(id);
          if (element) {
            element.textContent = value || "";
          }
        };

        const setSectionVisibility = (id, visible) => {
          const element = document.getElementById(id);
          if (element) {
            element.hidden = !visible;
          }
        };

        const setNavText = (key, value) => {
          const element = document.querySelector(`[data-detail-nav="${key}"]`);
          if (element) {
            element.textContent = value || "";
          }
        };

        const setNavVisibility = (key, visible) => {
          const element = document.querySelector(`[data-detail-nav="${key}"]`);
          if (element) {
            element.hidden = !visible;
          }
        };

        const getCopy = (lang) => liveProjectLocales[lang] || liveProjectLocales.es;

        const applyTheme = (theme, persist = true) => {
          state.theme = theme;
          document.documentElement.classList.toggle("dark", theme === "dark");
          document.documentElement.classList.toggle("light", theme === "light");
          document.documentElement.dataset.theme = theme;

          if (persist) {
            window.localStorage.setItem("portfolio-theme", theme);
          }

          if (themeToggleIcon) {
            themeToggleIcon.innerHTML = themeIconMarkup[theme];
          }

          if (themeToggle) {
            const label = theme === "dark" ? labels[state.lang].themeToLight : labels[state.lang].themeToDark;
            themeToggle.setAttribute("aria-label", label);
            themeToggle.setAttribute("title", label);
          }
        };

        const renderLinks = (links = []) => {
          const container = document.getElementById("detail-links");
          if (!container) {
            return;
          }

          container.hidden = links.length === 0;
          container.innerHTML = links
            .map((link, index) => {
              const isPrimary = index === 0 || link.type === "demo";
              const className = isPrimary
                ? "detail-action detail-action-primary"
                : "detail-action detail-action-secondary";

              return `
                <a class="${className}" href="${escapeHtml(withBase(link.href))}" target="_blank" rel="noopener noreferrer">
                  ${escapeHtml(link.label)}
                </a>
              `;
            })
            .join("");
        };

        const renderMetrics = (metrics = []) => {
          const container = document.getElementById("detail-metrics");
          if (!container) {
            return;
          }

          container.hidden = metrics.length === 0;
          container.innerHTML = metrics
            .map(
              (item) => `
                <div class="detail-metric-card glass-panel" data-detail-reveal>
                  <p class="text-3xl font-headline font-bold tracking-tight text-on-surface">${escapeHtml(item.value)}</p>
                  <p class="mt-2 text-[0.66rem] font-black uppercase tracking-[0.18em] text-on-surface-variant">${escapeHtml(item.label)}</p>
                </div>
              `,
            )
            .join("");
        };

        const renderProcess = (items = []) => {
          const container = document.getElementById("detail-process-list");
          setSectionVisibility("detail-process-section", items.length > 0);
          if (!container) {
            return;
          }

          container.innerHTML = items
            .map(
              (item, index) => `
                <article class="detail-timeline-item" data-detail-reveal>
                  <span class="detail-timeline-marker">${String(index + 1).padStart(2, "0")}</span>
                  <p class="mt-3 text-sm leading-7 text-on-surface-variant">${escapeHtml(item)}</p>
                </article>
              `,
            )
            .join("");
        };

        const renderResults = (value = "") => {
          const container = document.getElementById("detail-results-body");
          const text = Array.isArray(value) ? value.join("\n") : value;
          setSectionVisibility("detail-results-section", hasText(text));
          if (!container) {
            return;
          }

          container.textContent = text || "";
        };

        const renderPills = (items = []) => {
          const container = document.getElementById("detail-stack-list");
          setSectionVisibility("detail-stack-section", items.length > 0);
          if (!container) {
            return;
          }

          container.innerHTML = items
            .map(
              (item) => `
                <span class="detail-stack-pill">
                  ${escapeHtml(item)}
                </span>
              `,
            )
            .join("");
        };

        const renderBulletList = (sectionId, containerId, items = []) => {
          const container = document.getElementById(containerId);
          setSectionVisibility(sectionId, items.length > 0);
          if (!container) {
            return;
          }

          container.innerHTML = items
            .map(
              (item) => `
                <li class="detail-check-item">
                  <span class="material-symbols-outlined" aria-hidden="true">check_circle</span>
                  <span>${escapeHtml(item)}</span>
                </li>
              `,
            )
            .join("");
        };

        const renderCollaborators = (items = []) => {
          const container = document.getElementById("detail-collaborators-list");
          setSectionVisibility("detail-collaborators-section", items.length > 0);
          if (!container) {
            return;
          }

          container.innerHTML = items
            .map((collaborator) => {
              const links = [
                collaborator.portfolioUrl ? { href: collaborator.portfolioUrl, label: "Portfolio" } : null,
                collaborator.githubUrl ? { href: collaborator.githubUrl, label: "GitHub" } : null,
                collaborator.linkedinUrl ? { href: collaborator.linkedinUrl, label: "LinkedIn" } : null,
              ].filter(Boolean);
              const initials = collaborator.name
                .split(/\s+/)
                .filter(Boolean)
                .slice(0, 2)
                .map((part) => part.charAt(0).toUpperCase())
                .join("");

              return `
                <article class="detail-collaborator-card">
                  ${
                    collaborator.photo
                      ? `<img src="${escapeHtml(withBase(collaborator.photo))}" alt="${escapeHtml(collaborator.name)}" loading="lazy" />`
                      : `<span class="detail-collaborator-avatar" aria-hidden="true">${escapeHtml(initials || "C")}</span>`
                  }
                  <div class="min-w-0">
                    <h3>${escapeHtml(collaborator.name)}</h3>
                    ${collaborator.role ? `<p>${escapeHtml(collaborator.role)}</p>` : ""}
                    ${
                      links.length > 0
                        ? `<div class="detail-collaborator-links">${links
                            .map(
                              (link) => `
                                <a href="${escapeHtml(withBase(link.href))}" target="_blank" rel="noopener noreferrer">
                                  ${escapeHtml(link.label)}
                                </a>
                              `,
                            )
                            .join("")}</div>`
                        : ""
                    }
                  </div>
                </article>
              `;
            })
            .join("");
        };

        const renderHeroVisual = (image, copy) => {
          const heroVisual = document.getElementById("detail-hero-visual");
          if (!heroVisual) {
            return;
          }

          const heroSrc = image?.src || liveProjectPreviewImage || "";
          if (!heroSrc) {
            heroVisual.className = `project-visual ${liveProjectVisualClass || "visual-brand"} detail-hero-visual min-h-[320px] rounded-[1.25rem] sm:min-h-[380px]`;
            heroVisual.innerHTML = "";
            return;
          }

          heroVisual.className =
            "project-visual project-live-visual detail-hero-visual detail-adaptive-image-frame relative overflow-hidden rounded-[1.25rem] border border-outline-variant/15 bg-white";
          heroVisual.innerHTML = `
            <img
              id="detail-hero-image"
              src="${escapeHtml(withBase(heroSrc))}"
              alt="${escapeHtml(image?.alt || `${copy.title} ${labels[state.lang].imageFallback}`)}"
              loading="eager"
              class="project-preview-image"
            />
          `;
          syncAdaptiveImageFrames(heroVisual);
        };

        const renderImages = (images = [], copy) => {
          const grid = document.getElementById("detail-images-grid");
          setSectionVisibility("detail-images-section", images.length > 0);
          const previewSrc = copy.previewImage || liveProjectPreviewImage || projectPreviewImage || "";
          renderHeroVisual(previewSrc ? { src: previewSrc, alt: `${copy.title} ${labels[state.lang].imageFallback}` } : images[0], copy);

          if (!grid) {
            return;
          }

          grid.innerHTML = images
            .map(
              (image) => {
                const src = withBase(image.src);
                const alt = image.alt || labels[state.lang].imageFallback;
                const caption = image.caption || "";

                return `
                <figure class="detail-gallery-card" data-detail-reveal>
                  <button
                    type="button"
                    class="detail-gallery-zoom"
                    data-gallery-image
                    data-gallery-src="${escapeHtml(src)}"
                    data-gallery-alt="${escapeHtml(alt)}"
                    data-gallery-caption="${escapeHtml(caption)}"
                    aria-label="Ampliar imagen"
                  >
                    <div class="project-live-visual detail-adaptive-image-frame bg-white">
                      <img src="${escapeHtml(src)}" alt="${escapeHtml(alt)}" loading="lazy" class="project-preview-image" />
                    </div>
                  </button>
                  ${
                    caption
                      ? `<figcaption class="detail-gallery-caption">${escapeHtml(caption)}</figcaption>`
                      : ""
                  }
                </figure>
              `;
              },
            )
            .join("");
          syncAdaptiveImageFrames(grid);
        };

        const getYouTubeEmbedUrl = (url = "") => {
          if (!url) {
            return "";
          }

          try {
            const parsedUrl = new URL(url, window.location.origin);
            const host = parsedUrl.hostname.replace(/^www\./, "");

            if (host === "youtu.be") {
              const id = parsedUrl.pathname.replace(/^\/+/, "").split("/")[0];
              return id ? `https://www.youtube.com/embed/${encodeURIComponent(id)}` : "";
            }

            if (host.endsWith("youtube.com")) {
              const watchId = parsedUrl.searchParams.get("v");
              if (watchId) {
                return `https://www.youtube.com/embed/${encodeURIComponent(watchId)}`;
              }

              const [, kind, id] = parsedUrl.pathname.split("/");
              if ((kind === "shorts" || kind === "embed") && id) {
                return `https://www.youtube.com/embed/${encodeURIComponent(id)}`;
              }

              const playlistId = parsedUrl.searchParams.get("list");
              if (playlistId) {
                return `https://www.youtube.com/embed/videoseries?list=${encodeURIComponent(playlistId)}`;
              }
            }
          } catch {
            return "";
          }

          return "";
        };

        const renderVideos = (videos = []) => {
          const grid = document.getElementById("detail-videos-grid");
          setSectionVisibility("detail-videos-section", videos.length > 0);
          if (!grid) {
            return;
          }

          grid.innerHTML = videos
            .map(
              (video) => {
                const youtubeEmbedUrl = getYouTubeEmbedUrl(video.src);
                const media = youtubeEmbedUrl
                  ? `
                    <iframe
                      src="${escapeHtml(youtubeEmbedUrl)}"
                      title="${escapeHtml(video.title || labels[state.lang].youtube)}"
                      loading="lazy"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen
                      class="aspect-video w-full bg-black"
                    ></iframe>
                  `
                  : `
                    <video controls preload="metadata" ${video.poster ? `poster="${escapeHtml(withBase(video.poster))}"` : ""} class="aspect-video w-full bg-black">
                      <source src="${escapeHtml(withBase(video.src))}" />
                    </video>
                  `;

                return `
                  <figure class="detail-gallery-card" data-detail-reveal>
                    ${media}
                    <figcaption class="detail-gallery-caption">
                      <strong class="block text-on-surface">${escapeHtml(video.title)}</strong>
                      ${video.caption ? `<span class="mt-1 block">${escapeHtml(video.caption)}</span>` : ""}
                    </figcaption>
                  </figure>
                `;
              },
            )
            .join("");
        };

        const formatRichText = (value = "") =>
          escapeHtml(value)
            .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
            .replace(/\*(.*?)\*/g, "<em>$1</em>")
            .replace(/\n/g, "<br />");

        const stringifyModuleItem = (item) => {
          if (typeof item === "string") {
            return item;
          }

          if (!item || typeof item !== "object") {
            return "";
          }

          return [item.value, item.label, item.title, item.description].filter(Boolean).join(" - ");
        };

        const moduleTitles = {
          es: {
            "problem-solution": "Problema y solucion",
            roles: "Roles",
            features: "Funciones clave",
            architecture: "Arquitectura",
            stack: "Stack",
            metrics: "Metricas",
            gallery: "Galeria",
            links: "Enlaces",
            timeline: "Linea de trabajo",
            "case-study": "Caso de estudio",
            video: "Video",
            "custom-rich-text": "Notas",
            "custom-list": "Lista",
            "custom-code": "Codigo",
          },
          en: {
            "problem-solution": "Problem and solution",
            roles: "Roles",
            features: "Key features",
            architecture: "Architecture",
            stack: "Stack",
            metrics: "Metrics",
            gallery: "Gallery",
            links: "Links",
            timeline: "Work timeline",
            "case-study": "Case study",
            video: "Video",
            "custom-rich-text": "Notes",
            "custom-list": "List",
            "custom-code": "Code",
          },
        };

        const renderYoutube = (media = {}) => {
          const section = document.getElementById("detail-youtube-section");
          const frame = document.getElementById("detail-youtube-frame");
          const youtubeId = media.youtube?.youtubeId;
          const playlistId = media.youtube?.playlistId;
          const embedUrl = youtubeId
            ? `https://www.youtube.com/embed/${encodeURIComponent(youtubeId)}`
            : playlistId
              ? `https://www.youtube.com/embed/videoseries?list=${encodeURIComponent(playlistId)}`
              : "";

          setSectionVisibility("detail-youtube-section", Boolean(embedUrl));
          if (frame && embedUrl) {
            frame.src = embedUrl;
          } else if (frame) {
            frame.src = "";
          }

          return section;
        };

        const renderDynamicModules = (copy) => {
          const container = document.getElementById("detail-dynamic-modules-list");
          const modules = copy.modules || {};
          const moduleIds = Array.isArray(copy.modulesOrder) && copy.modulesOrder.length > 0 ? copy.modulesOrder : Object.keys(modules);
          const renderableModules = moduleIds
            .map((id) => ({ id, ...(modules[id] || {}) }))
            .filter((module) => module.body || module.code || module.items?.length || module.links?.length);

          setSectionVisibility("detail-dynamic-modules-section", renderableModules.length > 0);

          if (!container) {
            return;
          }

          container.innerHTML = renderableModules
            .map((module) => {
              const items = Array.isArray(module.items) ? module.items.map(stringifyModuleItem).filter(Boolean) : [];
              const links = Array.isArray(module.links) ? module.links : [];

              return `
                <article class="detail-module-card" data-detail-reveal>
                  <p class="detail-label">${escapeHtml(module.label || moduleTitles[state.lang]?.[module.id] || module.id)}</p>
                  <h3 class="mt-3 font-headline text-xl font-bold tracking-tight text-on-surface">${escapeHtml(module.title || moduleTitles[state.lang]?.[module.id] || module.id)}</h3>
                  ${module.body ? `<p class="mt-3 text-sm leading-7 text-on-surface-variant">${formatRichText(module.body)}</p>` : ""}
                  ${
                    items.length > 0
                      ? `<ul class="detail-module-list mt-4 grid gap-2 text-sm leading-7 text-on-surface-variant">${items.map((item) => `<li>${escapeHtml(item)}</li>`).join("")}</ul>`
                      : ""
                  }
                  ${
                    module.code
                      ? `<pre class="mt-4 overflow-auto rounded-[1rem] bg-black/55 p-4 text-xs leading-6 text-on-surface"><code>${escapeHtml(module.code)}</code></pre>`
                      : ""
                  }
                  ${
                    links.length > 0
                      ? `<div class="mt-4 flex flex-wrap gap-2">${links
                          .map(
                            (link) =>
                              `<a class="inline-flex items-center justify-center rounded-full border border-secondary/25 px-4 py-2 text-xs font-bold tracking-tight text-secondary transition hover:border-secondary hover:bg-secondary/5" href="${escapeHtml(withBase(link.href))}" target="_blank" rel="noopener noreferrer">${escapeHtml(link.label || link.href)}</a>`,
                          )
                          .join("")}</div>`
                      : ""
                  }
                </article>
              `;
            })
            .join("");
        };

        const applySectionOrder = (sectionOrder = []) => {
          const container = document.getElementById("detail-ordered-sections");
          if (!container) {
            return;
          }

          const sectionElements = {
            images: ["detail-images-section"],
            videos: ["detail-videos-section", "detail-youtube-section"],
            modules: ["detail-dynamic-modules-section"],
          };

          normalizeSectionOrder(sectionOrder).forEach((sectionId) => {
            sectionElements[sectionId]?.forEach((elementId) => {
              const element = document.getElementById(elementId);
              if (element) {
                container.appendChild(element);
              }
            });
          });
        };

        const renderRelated = (lang) => {
          const grid = document.getElementById("detail-related-grid");
          if (!grid) {
            return;
          }

          grid.innerHTML = relatedProjectCards
            .map((item) => {
              const copy = item.locales?.[lang] || item.locales?.es || {};
              const image = item.previewImage || copy.previewImage || copy.media?.images?.[0]?.src;
              const visual = image
                ? `
                  <div class="project-visual project-live-visual relative overflow-hidden rounded-[1.3rem] border border-outline-variant/15 bg-white">
                    <img src="${escapeHtml(withBase(image))}" alt="${escapeHtml(copy.title)}" loading="lazy" class="project-preview-image" />
                  </div>
                `
                : `<div class="project-visual ${escapeHtml(item.visualClass || liveProjectVisualClass)} aspect-[16/10] rounded-[1.3rem]"></div>`;

              return `
                <a href="${escapeHtml(withBase(item.href || `/proyectos/${item.slug}`))}" class="project-card group flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-outline-variant/18 bg-surface-container-highest/90 p-3.5">
                  ${visual}
                  <div class="flex h-full flex-col px-1.5 pb-1 pt-4">
                    <div class="flex items-start justify-between gap-4">
                      <div>
                        <p class="text-[0.65rem] font-black uppercase tracking-[0.2em] text-secondary">${escapeHtml(copy.accent || "")}</p>
                        <h3 class="mt-2 font-headline text-[1.45rem] font-bold tracking-tight text-on-surface">${escapeHtml(copy.title || item.slug)}</h3>
                      </div>
                      <span class="material-symbols-outlined text-primary transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">north_east</span>
                    </div>
                    <p class="mt-3 flex-1 text-sm leading-6 text-on-surface-variant">${escapeHtml(copy.summary || copy.description || "")}</p>
                  </div>
                </a>
              `;
            })
            .join("");
        };

        const applyLanguage = (lang, persist = true) => {
          state.lang = lang;
          const copy = getCopy(lang);
          const label = labels[lang];

          if (persist) {
            window.localStorage.setItem("portfolio-lang", lang);
          }

          document.documentElement.lang = lang;
          document.title = `${copy.title} | Jonathan Acevedo`;
          document.querySelector('meta[name="description"]')?.setAttribute("content", copy.summary || copy.description || "");

          setText("detail-back-label", label.back);
          setText("detail-kicker", `${copy.accent} - ${liveProjectYear}`);
          setText("detail-title", copy.title);
          setText("detail-device-title", copy.title);
          setText("detail-summary", copy.summary);
          setText("detail-category-label", label.category);
          setText("detail-format-label", label.format);
          setText("detail-focus-label", label.focus);
          setText("detail-category-value", copy.category);
          setText("detail-format-value", copy.tag);
          setText("detail-focus-value", copy.accent);
          setText("detail-overview-label", label.overview);
          setText("detail-overview", copy.overview);
          setText("detail-long-description-label", label.longDescription);
          setText("detail-long-description", copy.longDescription);
          setText("detail-challenge-label", label.challenge);
          setText("detail-challenge", copy.challenge);
          setText("detail-solution-label", label.solution);
          setText("detail-solution", copy.solution);
          setText("detail-process-title", label.process);
          setText("detail-images-eyebrow", label.imagesEyebrow);
          setText("detail-images-title", label.imagesTitle);
          setText("detail-videos-title", label.videos);
          setText("detail-youtube-title", label.youtube);
          setText("detail-dynamic-modules-title", label.dynamicModules);
          setText("detail-results-title", label.results);
          setText("detail-stack-title", label.stack);
          setText("detail-deliverables-title", label.deliverables);
          setText("detail-learnings-title", label.learnings);
          setText("detail-collaborators-title", label.collaborators);
          setText("detail-related-title", label.related);
          setText("detail-related-link", label.viewAll);
          setText("detail-live-eyebrow", label.liveEyebrow);
          setText("detail-live-title", copy.interactiveTitle);
          setText("detail-live-description", copy.interactiveDescription);
          setText("detail-open-live", label.openLive);
          setText("detail-contact-cta", label.contact);
          setText("detail-live-note", label.liveNote);
          setText("detail-iframe-url", liveProjectLiveUrl || "");
          setNavText("context", label.navContext);
          setNavText("process", label.navProcess);
          setNavText("impact", label.navImpact);
          setNavText("visuals", label.navVisuals);
          setNavText("live", label.navLive);

          if (languageToggle) {
            languageToggle.textContent = label.languageToggle;
            languageToggle.setAttribute("aria-label", label.languageTitle);
            languageToggle.setAttribute("title", label.languageTitle);
          }

          renderMetrics(copy.metrics);
          renderLinks(copy.links);
          renderProcess(copy.process);
          renderResults(copy.results);
          renderPills(copy.stack);
          renderBulletList("detail-deliverables-section", "detail-deliverables-list", copy.deliverables);
          renderBulletList("detail-learnings-section", "detail-learnings-list", copy.learnings);
          renderCollaborators(copy.collaborators || []);
          renderImages(copy.media?.images || [], copy);
          renderVideos(copy.media?.videos || []);
          renderYoutube(copy.media || {});
          renderDynamicModules(copy);
          applySectionOrder(copy.sectionOrder);
          renderRelated(lang);
          setSectionVisibility("detail-long-description-section", Boolean(copy.longDescription));
          setNavVisibility("process", Array.isArray(copy.process) && copy.process.length > 0);
          setNavVisibility("impact", hasText(copy.results) || (Array.isArray(copy.metrics) && copy.metrics.length > 0));
          setNavVisibility(
            "visuals",
            Boolean(copy.media?.youtube?.youtubeId || copy.media?.youtube?.playlistId) ||
              (Array.isArray(copy.media?.images) && copy.media.images.length > 0) ||
              (Array.isArray(copy.media?.videos) && copy.media.videos.length > 0),
          );
          setNavVisibility("live", Boolean(liveProjectLiveUrl));
          applyTheme(state.theme, false);
          scheduleRevealAnimations();
        };

        const openGalleryLightbox = ({ src, alt, caption }) => {
          const lightbox = document.getElementById("detail-gallery-lightbox");
          const image = document.getElementById("detail-gallery-lightbox-image");
          const captionElement = document.getElementById("detail-gallery-lightbox-caption");
          const closeButton = document.getElementById("detail-gallery-lightbox-close");

          if (!lightbox || !image || !src) {
            return;
          }

          image.setAttribute("src", src);
          image.setAttribute("alt", alt || "");

          if (captionElement) {
            captionElement.textContent = caption || "";
            captionElement.hidden = !caption;
          }

          lightbox.hidden = false;
          lightbox.setAttribute("aria-hidden", "false");
          document.body.classList.add("is-gallery-lightbox-open");
          closeButton?.focus({ preventScroll: true });
        };

        const closeGalleryLightbox = () => {
          const lightbox = document.getElementById("detail-gallery-lightbox");
          const image = document.getElementById("detail-gallery-lightbox-image");

          if (!lightbox || lightbox.hidden) {
            return;
          }

          lightbox.hidden = true;
          lightbox.setAttribute("aria-hidden", "true");
          document.body.classList.remove("is-gallery-lightbox-open");
          image?.setAttribute("src", "");
        };

        applyTheme(state.theme, false);
        applyLanguage(state.lang, false);

        document.addEventListener("click", (event) => {
          const galleryTrigger = event.target instanceof Element ? event.target.closest("[data-gallery-image]") : null;
          if (galleryTrigger) {
            event.preventDefault();
            openGalleryLightbox({
              src: galleryTrigger.getAttribute("data-gallery-src") || "",
              alt: galleryTrigger.getAttribute("data-gallery-alt") || "",
              caption: galleryTrigger.getAttribute("data-gallery-caption") || "",
            });
            return;
          }

          const lightbox = document.getElementById("detail-gallery-lightbox");
          const closeTrigger = event.target instanceof Element ? event.target.closest("[data-gallery-close]") : null;
          if (closeTrigger || event.target === lightbox) {
            event.preventDefault();
            closeGalleryLightbox();
            return;
          }

          const button = event.target instanceof Element ? event.target.closest("[data-carousel-target]") : null;
          if (!button) {
            return;
          }

          const track = document.getElementById(button.getAttribute("data-carousel-target") || "");
          if (!track) {
            return;
          }

          const direction = Number(button.getAttribute("data-carousel-direction") || "1");
          const firstSlide = track.querySelector(".detail-gallery-card");
          const gap = Number.parseFloat(window.getComputedStyle(track).columnGap || "16") || 16;
          const distance = firstSlide ? firstSlide.getBoundingClientRect().width + gap : track.clientWidth * 0.85;

          track.scrollBy({
            left: direction * distance,
            behavior: "smooth",
          });
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            closeGalleryLightbox();
          }
        });

        themeToggle?.addEventListener("click", () => {
          state.theme = state.theme === "dark" ? "light" : "dark";
          applyTheme(state.theme);
        });

        languageToggle?.addEventListener("click", () => {
          applyLanguage(state.lang === "es" ? "en" : "es");
        });

        if (isStudioPreview) {
          refreshStudioPreview();
          window.setInterval(refreshStudioPreview, 650);
          window.addEventListener("focus", refreshStudioPreview);
        }
      })();
    </script>
  </body>
</html>
