---
import { projectDetails } from "../../data/project-details";
import "../../styles/global.css";

export function getStaticPaths() {
  return projectDetails.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const relatedProjects = projectDetails.filter((item) => item.slug !== project.slug).slice(0, 2);
const isDocqee = project.slug === "docqee";
const baseUrl = import.meta.env.BASE_URL || "/";
const withBase = (path) => `${baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`}${path.replace(/^\//, "")}`;
const controlHubMetrics = project.metrics ?? [];
const controlHubModules = project.modules ?? [];
const controlHubFlow = project.flow ?? [];
const interactiveTitle = project.interactiveTitle ?? `Explora ${project.title} desde el portafolio`;
const interactiveDescription =
  project.interactiveDescription ??
  "Esta demo en vivo carga el proyecto publicado para que puedas recorrerlo directamente desde esta ficha.";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{project.title} | Jonathan Acevedo</title>
    <meta name="description" content={project.summary} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        if ("scrollRestoration" in window.history) {
          window.history.scrollRestoration = "manual";
        }

        const storedTheme = window.localStorage.getItem("portfolio-theme");
        const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = storedTheme || (systemPrefersDark ? "dark" : "light");

        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.classList.toggle("light", theme === "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body class="bg-background font-body text-on-surface selection:bg-secondary/30">
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="orb orb-primary"></div>
      <div class="orb orb-secondary"></div>
      <div class="grid-overlay"></div>
    </div>

    <header class="sticky top-0 z-50 px-3 pt-3 lg:px-4">
      <nav class="site-shell site-shell--nav mx-auto flex max-w-7xl items-center justify-between rounded-[1.7rem] border border-outline-variant/15 bg-background/72 px-5 py-3 shadow-[0_18px_54px_rgba(0,0,0,0.24)] backdrop-blur-xl lg:px-7">
        <a
          id="detail-back-link"
          href={withBase("/#projects")}
          class="inline-flex items-center gap-2 rounded-full border border-outline-variant/20 bg-surface-container-highest/50 px-4 py-2 text-sm font-bold tracking-tight text-on-surface transition hover:border-secondary hover:text-secondary"
        >
          <span class="material-symbols-outlined text-[1.15rem]">arrow_back</span>
          <span id="detail-back-label">Volver al portafolio</span>
        </a>

        <div class="flex items-center gap-3">
          <button
            type="button"
            id="detail-theme-toggle"
            class="theme-toggle border border-outline-variant/20 bg-surface-container-highest/50 text-on-surface transition hover:border-secondary hover:text-secondary"
            aria-label="Cambiar a modo claro"
            title="Cambiar a modo claro"
          >
            <span class="theme-toggle-icon" id="detail-theme-toggle-icon" aria-hidden="true"></span>
          </button>
        </div>
      </nav>
    </header>

    <main class="detail-page-main px-6 pb-20 pt-10 lg:px-8 lg:pt-12">
      {isDocqee ? (
        <>
          <section class="site-shell site-shell--main mx-auto max-w-5xl">
            <div>
              <p class="text-[0.72rem] font-black uppercase tracking-[0.22em] text-secondary">
                {project.accent} - {project.year}
              </p>
              <h1 class="detail-display mt-4 max-w-4xl font-headline text-4xl font-bold leading-[1.02] tracking-tight text-on-surface sm:text-5xl lg:text-6xl">
                {project.title}
              </h1>
              <p class="mt-6 max-w-3xl text-lg leading-8 text-on-surface-variant">
                {project.summary}
              </p>

              <div class="mt-8 grid gap-4 sm:grid-cols-3">
                {controlHubMetrics.map((item) => (
                  <div class="glass-panel rounded-[1.5rem] border border-outline-variant/15 p-5">
                    <p class="text-3xl font-headline font-bold tracking-tight text-on-surface">{item.value}</p>
                    <p class="mt-2 text-[0.72rem] font-black uppercase tracking-[0.18em] text-on-surface-variant">
                      {item.label}
                    </p>
                  </div>
                ))}
              </div>

              <div class="mt-8 grid gap-4 sm:grid-cols-2">
                <article class="glass-panel rounded-[1.8rem] border border-outline-variant/15 p-6">
                  <p class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Problema</p>
                  <p class="mt-4 text-sm leading-7 text-on-surface-variant">{project.challenge}</p>
                </article>
                <article class="glass-panel rounded-[1.8rem] border border-outline-variant/15 p-6">
                  <p class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Direccion</p>
                  <p class="mt-4 text-sm leading-7 text-on-surface-variant">{project.solution}</p>
                </article>
              </div>
            </div>
          </section>

          <section class="site-shell site-shell--main mx-auto mt-12 grid max-w-7xl gap-8 lg:grid-cols-12">
            <div class="space-y-8 lg:col-span-7">
              <article class="glass-panel rounded-[2rem] border border-outline-variant/15 p-7 lg:p-8">
                <p class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Resumen del proyecto</p>
                <p class="mt-5 text-base leading-8 text-on-surface-variant">{project.overview}</p>
              </article>

              <section class="glass-panel rounded-[2rem] border border-outline-variant/15 p-7 lg:p-8">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                  <div>
                    <p class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Arquitectura de interfaz</p>
                    <h2 class="mt-3 font-headline text-2xl font-bold tracking-tight text-on-surface">Modulos principales</h2>
                  </div>
                  <p class="max-w-xl text-sm leading-7 text-on-surface-variant">
                    La interfaz se penso para hacer visible el recorrido entre paciente, estudiante y supervision docente.
                  </p>
                </div>

                <div class="mt-7 grid gap-4 sm:grid-cols-2">
                  {controlHubModules.map((item) => (
                    <article class="rounded-[1.4rem] border border-outline-variant/15 bg-surface-container-highest/55 p-5">
                      <h3 class="font-headline text-xl font-bold tracking-tight text-on-surface">{item.title}</h3>
                      <p class="mt-3 text-sm leading-7 text-on-surface-variant">{item.description}</p>
                    </article>
                  ))}
                </div>
              </section>

              <section class="glass-panel rounded-[2rem] border border-outline-variant/15 p-7 lg:p-8">
                <p class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Flujo de uso</p>
                <div class="mt-7 grid gap-4 lg:grid-cols-3">
                  {controlHubFlow.map((item) => (
                    <article class="rounded-[1.45rem] border border-outline-variant/15 bg-surface-container-highest/55 p-5">
                      <p class="text-[0.74rem] font-black uppercase tracking-[0.18em] text-primary">{item.step}</p>
                      <h3 class="mt-3 font-headline text-xl font-bold tracking-tight text-on-surface">{item.title}</h3>
                      <p class="mt-3 text-sm leading-7 text-on-surface-variant">{item.description}</p>
                    </article>
                  ))}
                </div>
              </section>
            </div>

            <aside class="space-y-8 lg:col-span-5">
              <section class="glass-panel rounded-[2rem] border border-outline-variant/15 p-7">
                <p class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Resultados</p>
                <div class="mt-5 space-y-3">
                  {project.results.map((item) => (
                    <div class="rounded-[1.25rem] border border-outline-variant/15 bg-surface-container-highest/55 px-4 py-4 text-sm leading-7 text-on-surface-variant">
                      {item}
                    </div>
                  ))}
                </div>
              </section>

              <section class="glass-panel rounded-[2rem] border border-outline-variant/15 p-7">
                <p class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Stack</p>
                <div class="mt-5 flex flex-wrap gap-3">
                  {project.stack.map((item) => (
                    <span class="rounded-full border border-outline-variant/18 bg-surface-container-highest/55 px-4 py-2 text-[0.7rem] font-black uppercase tracking-[0.18em] text-on-surface-variant">
                      {item}
                    </span>
                  ))}
                </div>
              </section>

              <section class="glass-panel rounded-[2rem] border border-outline-variant/15 p-7">
                <p class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Entregables</p>
                <ul class="mt-5 space-y-3 text-sm leading-7 text-on-surface-variant">
                  {project.deliverables.map((item) => (
                    <li class="flex items-start gap-3">
                      <span class="mt-2 inline-block h-2.5 w-2.5 rounded-full bg-primary"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </section>
            </aside>
          </section>
        </>
      ) : (
        <>
          <section class="site-shell site-shell--main mx-auto grid max-w-7xl gap-8 lg:grid-cols-12 lg:items-start lg:gap-10">
            <div class="lg:col-span-7">
              <p class="text-[0.72rem] font-black uppercase tracking-[0.22em] text-secondary">
                {project.accent} - {project.year}
              </p>
              <h1 class="detail-display mt-4 max-w-4xl font-headline text-4xl font-bold leading-[1.02] tracking-tight text-on-surface sm:text-5xl lg:text-6xl">
                {project.title}
              </h1>
              <p class="mt-6 max-w-3xl text-lg leading-8 text-on-surface-variant">
                {project.summary}
              </p>

              <div class="mt-8 grid gap-4 sm:grid-cols-3">
                <div class="glass-panel rounded-[1.4rem] border border-outline-variant/15 p-5">
                  <p class="text-[0.66rem] font-black uppercase tracking-[0.18em] text-primary">Categoria</p>
                  <p class="mt-3 text-sm font-semibold text-on-surface">{project.category}</p>
                </div>
                <div class="glass-panel rounded-[1.4rem] border border-outline-variant/15 p-5">
                  <p class="text-[0.66rem] font-black uppercase tracking-[0.18em] text-primary">Formato</p>
                  <p class="mt-3 text-sm font-semibold text-on-surface">{project.tag}</p>
                </div>
                <div class="glass-panel rounded-[1.4rem] border border-outline-variant/15 p-5">
                  <p class="text-[0.66rem] font-black uppercase tracking-[0.18em] text-primary">Enfoque</p>
                  <p class="mt-3 text-sm font-semibold text-on-surface">{project.accent}</p>
                </div>
              </div>
            </div>

            <div class="lg:col-span-5">
              <div class="glass-panel rounded-[2rem] border border-outline-variant/15 p-4 shadow-[0_28px_90px_rgba(0,0,0,0.28)]">
                {project.previewImage ? (
                  <div class="project-visual project-live-visual relative min-h-[320px] overflow-hidden rounded-[1.6rem] border border-outline-variant/15 bg-white sm:min-h-[380px]">
                    <img
                      src={withBase(project.previewImage)}
                      alt={`Vista previa de ${project.title}`}
                      loading="lazy"
                      class="project-preview-image"
                    />
                  </div>
                ) : (
                  <div class={`project-visual ${project.visualClass} min-h-[320px] rounded-[1.6rem] sm:min-h-[380px]`}></div>
                )}
              </div>
            </div>
          </section>

          <section class="site-shell site-shell--main mx-auto mt-12 grid max-w-7xl gap-8 lg:grid-cols-12">
            <div class="space-y-8 lg:col-span-7">
              <article class="glass-panel rounded-[2rem] border border-outline-variant/15 p-7 lg:p-8">
                <p class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Resumen</p>
                <p class="mt-5 text-base leading-8 text-on-surface-variant">{project.overview}</p>
              </article>

              <article class="glass-panel rounded-[2rem] border border-outline-variant/15 p-7 lg:p-8">
                <p class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Reto</p>
                <p class="mt-5 text-base leading-8 text-on-surface-variant">{project.challenge}</p>
              </article>

              <article class="glass-panel rounded-[2rem] border border-outline-variant/15 p-7 lg:p-8">
                <p class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Solucion</p>
                <p class="mt-5 text-base leading-8 text-on-surface-variant">{project.solution}</p>
              </article>
            </div>

            <aside class="space-y-8 lg:col-span-5">
              <section class="glass-panel rounded-[2rem] border border-outline-variant/15 p-7">
                <p class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Resultados</p>
                <div class="mt-5 space-y-3">
                  {project.results.map((item) => (
                    <div class="rounded-[1.25rem] border border-outline-variant/15 bg-surface-container-highest/55 px-4 py-4 text-sm leading-7 text-on-surface-variant">
                      {item}
                    </div>
                  ))}
                </div>
              </section>

              <section class="glass-panel rounded-[2rem] border border-outline-variant/15 p-7">
                <p class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Stack</p>
                <div class="mt-5 flex flex-wrap gap-3">
                  {project.stack.map((item) => (
                    <span class="rounded-full border border-outline-variant/18 bg-surface-container-highest/55 px-4 py-2 text-[0.7rem] font-black uppercase tracking-[0.18em] text-on-surface-variant">
                      {item}
                    </span>
                  ))}
                </div>
              </section>

              <section class="glass-panel rounded-[2rem] border border-outline-variant/15 p-7">
                <p class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Entregables</p>
                <ul class="mt-5 space-y-3 text-sm leading-7 text-on-surface-variant">
                  {project.deliverables.map((item) => (
                    <li class="flex items-start gap-3">
                      <span class="mt-2 inline-block h-2.5 w-2.5 rounded-full bg-primary"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </section>
            </aside>
          </section>
        </>
      )}

      {project.liveUrl ? (
        <section class="site-shell site-shell--main mx-auto mt-12 max-w-7xl">
          <div class="glass-panel overflow-hidden rounded-[2rem] border border-outline-variant/15 p-5 shadow-[0_28px_80px_rgba(0,0,0,0.22)] sm:p-6 lg:p-8">
            <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
              <div class="max-w-3xl">
                <p class="text-[0.68rem] font-black uppercase tracking-[0.2em] text-secondary">Vista interactiva</p>
                <h2 class="mt-3 font-headline text-2xl font-bold tracking-tight text-on-surface sm:text-3xl">
                  {interactiveTitle}
                </h2>
                <p class="mt-4 text-sm leading-7 text-on-surface-variant sm:text-base">
                  {interactiveDescription}
                </p>
              </div>

              <div class="flex flex-col gap-3 sm:flex-row">
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center rounded-2xl bg-primary px-5 py-3 text-sm font-bold tracking-tight text-on-primary transition hover:-translate-y-0.5"
                >
                  Abrir en pestaña nueva
                </a>
                <a
                  href={withBase("/#contact")}
                  class="inline-flex items-center justify-center rounded-2xl border border-secondary/25 px-5 py-3 text-sm font-bold tracking-tight text-secondary transition hover:border-secondary hover:bg-secondary/5"
                >
                  Hablar del proyecto
                </a>
              </div>
            </div>

            <div class="mt-6 overflow-hidden rounded-[1.7rem] border border-outline-variant/18 bg-white shadow-[0_22px_60px_rgba(8,16,38,0.22)]">
              <div class="flex items-center gap-2 border-b border-slate-200 bg-slate-100 px-4 py-3">
                <span class="h-3 w-3 rounded-full bg-rose-400"></span>
                <span class="h-3 w-3 rounded-full bg-amber-400"></span>
                <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
                <span class="ml-3 rounded-full bg-white px-3 py-1 text-xs font-semibold tracking-tight text-slate-500">
                  {project.liveUrl}
                </span>
              </div>

              <iframe
                src={project.liveUrl}
                title={`Demo interactiva de ${project.title}`}
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                sandbox="allow-forms allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts"
                allow="fullscreen"
                class="h-[34rem] w-full bg-white sm:h-[38rem] lg:h-[46rem]"
              ></iframe>
            </div>

            <p class="mt-4 text-xs font-semibold tracking-tight text-on-surface-variant sm:text-sm">
              Si tu navegador bloquea la vista embebida, puedes abrir Docqee en una pestaña nueva con el boton superior.
            </p>
          </div>
        </section>
      ) : null}

      <section class="site-shell site-shell--main mx-auto mt-12 max-w-7xl">
        <div class="mb-6 flex items-center justify-between gap-4">
          <h2 id="detail-related-title" class="font-headline text-2xl font-bold tracking-tight text-on-surface sm:text-3xl">Otros proyectos</h2>
          <a
            id="detail-related-link"
            href={withBase("/#projects")}
            class="text-sm font-bold tracking-tight text-secondary transition hover:text-on-surface"
          >
            Ver todos
          </a>
        </div>

        <div class="grid gap-6 lg:grid-cols-2">
          {relatedProjects.map((item) => (
            <a
              href={withBase(`/proyectos/${item.slug}`)}
              class="project-card group flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-outline-variant/18 bg-surface-container-highest/90 p-3.5"
            >
              {item.previewImage ? (
                <div class="project-visual project-live-visual relative overflow-hidden rounded-[1.3rem] border border-outline-variant/15 bg-white">
                  <img
                    src={withBase(item.previewImage)}
                    alt={`Vista previa de ${item.title}`}
                    loading="lazy"
                    class="project-preview-image"
                  />
                </div>
              ) : (
                <div class={`project-visual ${item.visualClass} aspect-[16/10] rounded-[1.3rem]`}></div>
              )}
              <div class="flex h-full flex-col px-1.5 pb-1 pt-4">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="text-[0.65rem] font-black uppercase tracking-[0.2em] text-secondary">{item.accent}</p>
                    <h3 class="mt-2 font-headline text-[1.45rem] font-bold tracking-tight text-on-surface">{item.title}</h3>
                  </div>
                  <span class="material-symbols-outlined text-primary transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">north_east</span>
                </div>
                <p class="mt-3 flex-1 text-sm leading-6 text-on-surface-variant">{item.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>

    <script is:inline>
      (() => {
        const copy = {
          themeToDark: "Cambiar a modo oscuro",
          themeToLight: "Cambiar a modo claro",
        };

        const themeToggle = document.getElementById("detail-theme-toggle");
        const themeToggleIcon = document.getElementById("detail-theme-toggle-icon");

        const themeIconMarkup = {
          dark: `
            <svg class="icon-symbol theme-toggle-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2.2"></path>
              <path d="M12 19.8V22"></path>
              <path d="m4.93 4.93 1.56 1.56"></path>
              <path d="m17.51 17.51 1.56 1.56"></path>
              <path d="M2 12h2.2"></path>
              <path d="M19.8 12H22"></path>
              <path d="m4.93 19.07 1.56-1.56"></path>
              <path d="m17.51 6.49 1.56-1.56"></path>
            </svg>
          `,
          light: `
            <svg class="icon-symbol theme-toggle-glyph" viewBox="0 0 24 24" fill="currentColor">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7.2 7.2 0 1 0 9.8 9.8Z"></path>
            </svg>
          `,
        };

        const storedTheme = document.documentElement.dataset.theme || window.localStorage.getItem("portfolio-theme") || "dark";
        const state = {
          theme: storedTheme,
        };

        document.documentElement.lang = "es";

        const applyTheme = (theme, persist = true) => {
          state.theme = theme;
          document.documentElement.classList.toggle("dark", theme === "dark");
          document.documentElement.classList.toggle("light", theme === "light");
          document.documentElement.dataset.theme = theme;

          if (persist) {
            window.localStorage.setItem("portfolio-theme", theme);
          }

          if (themeToggleIcon) {
            themeToggleIcon.innerHTML = themeIconMarkup[theme];
          }

          if (themeToggle) {
            const label = theme === "dark" ? copy.themeToLight : copy.themeToDark;
            themeToggle.setAttribute("aria-label", label);
            themeToggle.setAttribute("title", label);
          }
        };

        applyTheme(state.theme, false);

        themeToggle?.addEventListener("click", () => {
          state.theme = state.theme === "dark" ? "light" : "dark";
          applyTheme(state.theme);
        });
      })();
    </script>
  </body>
</html>
