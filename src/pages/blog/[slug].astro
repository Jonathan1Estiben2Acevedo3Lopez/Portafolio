---
import { Image } from "astro:assets";
import { getBlogDetailBySlug, getBlogDetails } from "../../data/blog-details";
import authorImage from "../../assets/Jonathan_Acevedo.webp";
import "../../styles/global.css";

export function getStaticPaths() {
  return getBlogDetails().map((post) => ({
    params: { slug: post.slug },
  }));
}

const baseUrl = import.meta.env.BASE_URL || "/";
const withBase = (path) => `${baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`}${path.replace(/^\//, "")}`;
const post = getBlogDetailBySlug(Astro.params.slug);
const relatedPosts = getBlogDetails().filter((item) => item.slug !== post.slug).slice(0, 3);
const articleImage = post.articleImage || post.cover || "";
const articlePhrase = post.phrase || "";
const articleImageCredit = post.imageCredit || "";
const articleParagraphs = Array.isArray(post.paragraphs) ? post.paragraphs : [];
const articleHighlights = Array.isArray(post.highlights) ? post.highlights.filter(Boolean) : [];
const blogAuthorName = "Jonathan Acevedo López";
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.title} | Blog Jonathan Acevedo</title>
    <meta name="description" content={post.excerpt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        if ("scrollRestoration" in window.history) {
          window.history.scrollRestoration = "manual";
        }

        const storedTheme = window.localStorage.getItem("portfolio-theme");
        const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = storedTheme || (systemPrefersDark ? "dark" : "light");

        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.classList.toggle("light", theme === "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body class="bg-background font-body text-on-surface selection:bg-secondary/30">
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="orb orb-primary"></div>
      <div class="orb orb-secondary"></div>
      <div class="grid-overlay"></div>
    </div>

    <header class="sticky top-0 z-50 px-3 pt-3 lg:px-4">
      <nav class="site-shell site-shell--nav mx-auto flex max-w-7xl items-center justify-between rounded-[1.7rem] border border-outline-variant/15 bg-background/72 px-5 py-3 shadow-[0_18px_54px_rgba(0,0,0,0.24)] backdrop-blur-xl lg:px-7">
        <a
          id="detail-back-link"
          href={withBase("/#insights")}
          class="inline-flex items-center gap-2 rounded-full border border-outline-variant/20 bg-surface-container-highest/50 px-4 py-2 text-sm font-bold tracking-tight text-on-surface transition hover:border-secondary hover:text-secondary"
        >
          <span class="material-symbols-outlined text-[1.15rem]">arrow_back</span>
          <span id="detail-back-label">Volver al blog</span>
        </a>

        <div class="flex items-center gap-3">
          <button
            type="button"
            id="detail-theme-toggle"
            class="theme-toggle border border-outline-variant/20 bg-surface-container-highest/50 text-on-surface transition hover:border-secondary hover:text-secondary"
            aria-label="Cambiar a modo claro"
            title="Cambiar a modo claro"
          >
            <span class="theme-toggle-icon" id="detail-theme-toggle-icon" aria-hidden="true"></span>
          </button>
        </div>
      </nav>
    </header>

    <main class="detail-page-main blog-article-page px-5 pb-20 pt-9 sm:px-6 lg:px-8 lg:pt-12">
      <section class="site-shell site-shell--main blog-article-hero mx-auto max-w-5xl text-center">
        <div class="blog-article-meta justify-center">
          <span class="text-primary">{post.category}</span>
          <span>{post.date}</span>
          <span>{post.readTime}</span>
        </div>
        <h1 id="blog-article-title" class="blog-article-title mx-auto mt-5 max-w-4xl font-headline font-bold leading-[1.08] tracking-tight text-on-surface">
          {post.title}
        </h1>
        {articlePhrase ? (
          <p class="blog-article-phrase mx-auto mt-5 max-w-3xl text-on-surface-variant">
            {articlePhrase}
          </p>
        ) : null}
      </section>

      <section class="site-shell site-shell--main blog-article-shell mx-auto mt-10 grid max-w-6xl gap-8 lg:grid-cols-[minmax(0,43rem)_minmax(18rem,1fr)] lg:items-start lg:gap-10">
        <article class="blog-article-prose" aria-labelledby="blog-article-title">
          <p class="blog-article-intro">{post.introduction}</p>
          {articleParagraphs.map((paragraph) => <p class="blog-article-main-point">{paragraph}</p>)}
          <div class="blog-article-author" aria-label={`Blog creado por ${blogAuthorName}`}>
            <Image
              src={authorImage}
              alt={`Foto de ${blogAuthorName}`}
              class="blog-article-author-photo"
              widths={[96, 128, 160, 224]}
              sizes="3.75rem"
              quality={86}
              loading="lazy"
              decoding="async"
            />
            <div class="blog-article-author-copy">
              <p>Blog creado por</p>
              <strong>{blogAuthorName}</strong>
            </div>
          </div>
        </article>

        <aside class="blog-article-sidebar lg:sticky lg:top-28">
          <div class="blog-article-info">
            <p class="detail-section-label">Lectura</p>
            <dl class="mt-5 grid gap-4">
              <div>
                <dt>Categoria</dt>
                <dd>{post.category}</dd>
              </div>
              <div>
                <dt>Publicado</dt>
                <dd>{post.date}</dd>
              </div>
              <div>
                <dt>Tiempo</dt>
                <dd>{post.readTime}</dd>
              </div>
            </dl>
          </div>

          {articleHighlights.length ? (
            <div class="blog-article-key-ideas" aria-labelledby="blog-article-key-ideas-title">
              <p id="blog-article-key-ideas-title" class="detail-section-label">Ideas clave</p>
              <ul class="mt-5 grid list-none gap-3 p-0" role="list">
                {articleHighlights.map((highlight) => (
                  <li class="blog-article-highlight">
                    <span class="material-symbols-outlined blog-article-highlight-icon" aria-hidden="true">check_circle</span>
                    <p>{highlight}</p>
                  </li>
                ))}
              </ul>
            </div>
          ) : null}
        </aside>
      </section>

      {articleImage ? (
        <section class="site-shell site-shell--main mx-auto mt-12 max-w-5xl">
          <figure class="blog-article-media">
            <img
              src={withBase(articleImage)}
              alt={post.title}
              loading="lazy"
              decoding="async"
            />
            {articleImageCredit ? <figcaption>{articleImageCredit}</figcaption> : null}
          </figure>
        </section>
      ) : null}

      {relatedPosts.length ? (
        <section class="site-shell site-shell--main blog-related-section mx-auto mt-14 max-w-6xl">
          <div class="mb-6 flex items-center justify-between gap-4">
            <h2 id="detail-related-title" class="font-headline text-xl font-bold tracking-tight text-on-surface sm:text-2xl">
              Otros articulos
            </h2>
          </div>

          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {relatedPosts.map((item) => (
              <a
                href={withBase(`/blog/${item.slug}`)}
                class="blog-related-card article-list-card flex min-h-[9.5rem] flex-col justify-between rounded-[1rem] border border-outline-variant/15 bg-surface-container-highest/88 p-3.5 transition hover:-translate-y-1 hover:border-primary/40 hover:shadow-[0_20px_44px_rgba(0,0,0,0.16)]"
              >
                <div>
                  <p class="text-[0.58rem] font-black uppercase tracking-[0.18em] text-secondary">{item.category}</p>
                  <h3 class="mt-2.5 font-headline text-[1rem] font-bold leading-6 tracking-tight text-on-surface">
                    {item.title}
                  </h3>
                  <p class="mt-2.5 text-[0.8rem] leading-5 text-on-surface-variant">{item.excerpt}</p>
                </div>
                <div class="mt-4 flex items-center justify-between gap-4 text-[0.62rem] font-black uppercase tracking-[0.16em] text-on-surface-variant">
                  <span>{item.date}</span>
                  <span class="material-symbols-outlined text-primary">arrow_outward</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ) : null}
    </main>

    <script is:inline>
      (() => {
        const copy = {
          themeToDark: "Cambiar a modo oscuro",
          themeToLight: "Cambiar a modo claro",
        };

        const themeToggle = document.getElementById("detail-theme-toggle");
        const themeToggleIcon = document.getElementById("detail-theme-toggle-icon");

        const themeIconMarkup = {
          dark: `
            <svg class="icon-symbol theme-toggle-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2.2"></path>
              <path d="M12 19.8V22"></path>
              <path d="m4.93 4.93 1.56 1.56"></path>
              <path d="m17.51 17.51 1.56 1.56"></path>
              <path d="M2 12h2.2"></path>
              <path d="M19.8 12H22"></path>
              <path d="m4.93 19.07 1.56-1.56"></path>
              <path d="m17.51 6.49 1.56-1.56"></path>
            </svg>
          `,
          light: `
            <svg class="icon-symbol theme-toggle-glyph" viewBox="0 0 24 24" fill="currentColor">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7.2 7.2 0 1 0 9.8 9.8Z"></path>
            </svg>
          `,
        };

        const storedTheme = document.documentElement.dataset.theme || window.localStorage.getItem("portfolio-theme") || "dark";
        const state = {
          theme: storedTheme,
        };

        document.documentElement.lang = "es";

        const applyTheme = (theme, persist = true) => {
          state.theme = theme;
          document.documentElement.classList.toggle("dark", theme === "dark");
          document.documentElement.classList.toggle("light", theme === "light");
          document.documentElement.dataset.theme = theme;

          if (persist) {
            window.localStorage.setItem("portfolio-theme", theme);
          }

          if (themeToggleIcon) {
            themeToggleIcon.innerHTML = themeIconMarkup[theme];
          }

          if (themeToggle) {
            const label = theme === "dark" ? copy.themeToLight : copy.themeToDark;
            themeToggle.setAttribute("aria-label", label);
            themeToggle.setAttribute("title", label);
          }
        };

        applyTheme(state.theme, false);

        themeToggle?.addEventListener("click", () => {
          state.theme = state.theme === "dark" ? "light" : "dark";
          applyTheme(state.theme);
        });
      })();
    </script>
  </body>
</html>
