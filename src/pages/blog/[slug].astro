---
import { blogDetails } from "../../data/blog-details";
import "../../styles/global.css";

export function getStaticPaths() {
  return blogDetails.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const relatedPosts = blogDetails.filter((item) => item.slug !== post.slug).slice(0, 3);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.title} | Blog Jonathan Acevedo</title>
    <meta name="description" content={post.excerpt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        if ("scrollRestoration" in window.history) {
          window.history.scrollRestoration = "manual";
        }

        const storedTheme = window.localStorage.getItem("portfolio-theme");
        const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = storedTheme || (systemPrefersDark ? "dark" : "light");

        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.classList.toggle("light", theme === "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-background font-body text-on-surface selection:bg-secondary/30">
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
      <div class="orb orb-primary"></div>
      <div class="orb orb-secondary"></div>
      <div class="grid-overlay"></div>
    </div>

    <header class="sticky top-0 z-50 px-3 pt-3 lg:px-4">
      <nav class="site-shell site-shell--nav mx-auto flex max-w-7xl items-center justify-between rounded-[1.7rem] border border-outline-variant/15 bg-background/72 px-5 py-3 shadow-[0_18px_54px_rgba(0,0,0,0.24)] backdrop-blur-xl lg:px-7">
        <a
          id="detail-back-link"
          href="/#insights"
          class="inline-flex items-center gap-2 rounded-full border border-outline-variant/20 bg-surface-container-highest/50 px-4 py-2 text-sm font-bold tracking-tight text-on-surface transition hover:border-secondary hover:text-secondary"
        >
          <span class="material-symbols-outlined text-[1.15rem]">arrow_back</span>
          <span id="detail-back-label">Volver al blog</span>
        </a>

        <div class="flex items-center gap-3">
          <button
            type="button"
            id="detail-theme-toggle"
            class="theme-toggle border border-outline-variant/20 bg-surface-container-highest/50 text-on-surface transition hover:border-secondary hover:text-secondary"
            aria-label="Cambiar a modo claro"
            title="Cambiar a modo claro"
          >
            <span class="theme-toggle-icon" id="detail-theme-toggle-icon" aria-hidden="true"></span>
          </button>
        </div>
      </nav>
    </header>

    <main class="detail-page-main px-6 pb-20 pt-10 lg:px-8 lg:pt-12">
      <section class="site-shell site-shell--main detail-lead-grid mx-auto grid max-w-7xl gap-8 lg:grid-cols-[minmax(0,1.08fr)_minmax(18rem,0.92fr)] lg:items-start lg:gap-10">
        <div>
          <div class="flex flex-wrap items-center gap-4 text-[0.72rem] font-black uppercase tracking-[0.22em] text-on-surface-variant">
            <span class="text-primary">{post.category}</span>
            <span>{post.date}</span>
            <span>{post.readTime}</span>
          </div>
          <h1 class="detail-display mt-5 max-w-4xl font-headline text-4xl font-bold leading-[1.04] tracking-tight text-on-surface sm:text-5xl lg:text-6xl">
            {post.title}
          </h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-on-surface-variant">
            {post.excerpt}
          </p>

          <article class="mt-10 space-y-6 text-[1.03rem] leading-8 text-on-surface-variant">
            <p>{post.introduction}</p>
            {post.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </article>
        </div>

        <aside class="space-y-6 lg:sticky lg:top-28">
          <div class={`article-visual ${post.visualClass} min-h-[18rem] rounded-[2rem] border border-outline-variant/15`}></div>

          <div class="glass-panel rounded-[2rem] border border-outline-variant/15 p-6">
            <p id="detail-key-ideas-label" class="text-[0.68rem] font-black uppercase tracking-[0.22em] text-secondary">
              Ideas clave
            </p>
            <div class="mt-5 space-y-3">
              {post.highlights.map((item) => (
                <div class="rounded-[1.2rem] border border-outline-variant/15 bg-surface-container-highest/70 px-4 py-4 text-sm leading-7 text-on-surface-variant">
                  {item}
                </div>
              ))}
            </div>
          </div>
        </aside>
      </section>

      <section class="site-shell site-shell--main mx-auto mt-16 max-w-7xl">
        <div class="mb-6 flex items-center justify-between gap-4">
          <h2 id="detail-related-title" class="font-headline text-2xl font-bold tracking-tight text-on-surface sm:text-3xl">
            Otros articulos
          </h2>
        </div>

        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {relatedPosts.map((item) => (
            <a
              href={`/blog/${item.slug}`}
              class="article-list-card flex min-h-[14rem] flex-col justify-between rounded-[1.6rem] border border-outline-variant/15 bg-surface-container-highest/88 p-5 transition hover:-translate-y-1 hover:border-primary/40 hover:shadow-[0_24px_54px_rgba(0,0,0,0.18)]"
            >
              <div>
                <p class="text-[0.62rem] font-black uppercase tracking-[0.2em] text-secondary">{item.category}</p>
                <h3 class="mt-3 font-headline text-[1.2rem] font-bold leading-7 tracking-tight text-on-surface">
                  {item.title}
                </h3>
                <p class="mt-4 text-sm leading-7 text-on-surface-variant">{item.excerpt}</p>
              </div>
              <div class="mt-5 flex items-center justify-between gap-4 text-[0.68rem] font-black uppercase tracking-[0.18em] text-on-surface-variant">
                <span>{item.date}</span>
                <span class="material-symbols-outlined text-primary">arrow_outward</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>

    <script is:inline>
      (() => {
        const copy = {
          themeToDark: "Cambiar a modo oscuro",
          themeToLight: "Cambiar a modo claro",
        };

        const themeToggle = document.getElementById("detail-theme-toggle");
        const themeToggleIcon = document.getElementById("detail-theme-toggle-icon");

        const themeIconMarkup = {
          dark: `
            <svg class="icon-symbol theme-toggle-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2.2"></path>
              <path d="M12 19.8V22"></path>
              <path d="m4.93 4.93 1.56 1.56"></path>
              <path d="m17.51 17.51 1.56 1.56"></path>
              <path d="M2 12h2.2"></path>
              <path d="M19.8 12H22"></path>
              <path d="m4.93 19.07 1.56-1.56"></path>
              <path d="m17.51 6.49 1.56-1.56"></path>
            </svg>
          `,
          light: `
            <svg class="icon-symbol theme-toggle-glyph" viewBox="0 0 24 24" fill="currentColor">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7.2 7.2 0 1 0 9.8 9.8Z"></path>
            </svg>
          `,
        };

        const storedTheme = document.documentElement.dataset.theme || window.localStorage.getItem("portfolio-theme") || "dark";
        const state = {
          theme: storedTheme,
        };

        document.documentElement.lang = "es";

        const applyTheme = (theme, persist = true) => {
          state.theme = theme;
          document.documentElement.classList.toggle("dark", theme === "dark");
          document.documentElement.classList.toggle("light", theme === "light");
          document.documentElement.dataset.theme = theme;

          if (persist) {
            window.localStorage.setItem("portfolio-theme", theme);
          }

          if (themeToggleIcon) {
            themeToggleIcon.innerHTML = themeIconMarkup[theme];
          }

          if (themeToggle) {
            const label = theme === "dark" ? copy.themeToLight : copy.themeToDark;
            themeToggle.setAttribute("aria-label", label);
            themeToggle.setAttribute("title", label);
          }
        };

        applyTheme(state.theme, false);

        themeToggle?.addEventListener("click", () => {
          state.theme = state.theme === "dark" ? "light" : "dark";
          applyTheme(state.theme);
        });
      })();
    </script>
  </body>
</html>
