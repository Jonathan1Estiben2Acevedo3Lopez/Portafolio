{
  "name": "portafolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portafolio personal en Astro",
  "scripts": {
    "new:project": "node scripts/new-project.mjs",
    "sync:projects": "node scripts/sync-projects.mjs",
    "predev": "npm run sync:projects",
    "dev": "astro dev",
    "prebuild": "npm run sync:projects",
    "build": "astro build",
    "prepreview": "npm run sync:projects",
    "preview": "astro preview",
    "studio": "npm run studio:dev",
    "studio:install": "npm --prefix project-studio install",
    "studio:check": "node project-studio/scripts/check-tauri-env.mjs",
    "studio:dev": "npm run studio:install && npm run studio:check && npm --prefix project-studio run tauri:dev",
    "studio:build": "npm run studio:install && npm run studio:check && npm --prefix project-studio run tauri:build",
    "tauri:dev": "npm run studio:dev",
    "tauri:build": "npm run studio:build"
  },
  "dependencies": {
    "astro": "^6.0.8",
    "pdfjs-dist": "^5.7.284",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17"
  }
}
