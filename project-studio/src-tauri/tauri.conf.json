{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Studio",
  "version": "0.1.0",
  "identifier": "com.jonathanacevedo.projectstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Project Studio",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 660,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
